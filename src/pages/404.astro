---
import Layout from '../layouts/Layout.astro';
import { PUBLIC_API_URL } from '../lib/api';
---

<Layout title="Looca ID - Redirecting...">
  <div class="min-h-[70vh] flex flex-col items-center justify-center p-6 text-center">
    <div id="redirect-spinner" class="flex flex-col items-center gap-4">
      <div class="w-12 h-12 border-4 border-pink-deep border-t-transparent rounded-full animate-spin"></div>
      <p class="font-heading font-bold text-text-dark text-base" id="redirect-message">
        Redirecting you to the event registration...
      </p>
    </div>

    <div id="not-found-box" class="hidden flex flex-col items-center max-w-md mx-auto">
      <div class="w-16 h-16 rounded-full bg-pink-light flex items-center justify-center mb-4 text-pink-deep">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h2 class="font-heading font-extrabold text-2xl text-text-dark mb-2">Page Not Found</h2>
      <p class="text-xs sm:text-sm text-text-muted mb-6">
        The link you requested is not available or the event has concluded.
      </p>
      <a 
        href="/"
        class="inline-flex items-center gap-2 bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-xs sm:text-sm py-2.5 px-5 rounded-2xl shadow-md transition-all hover:scale-105"
      >
        <span>Back to Homepage</span>
      </a>
    </div>
  </div>

  <script define:vars={{ apiUrl: PUBLIC_API_URL }}>
    const handleRedirect = async () => {
      const pathname = window.location.pathname;
      const match = pathname.match(/^\/(?:event|r)\/([^/]+)/);

      if (match && match[1]) {
        const slug = match[1].toLowerCase();
        try {
          const res = await fetch(`${apiUrl}/api/public/events`);
          if (res.ok) {
            const events = await res.json();
            if (Array.isArray(events)) {
              const found = events.find((e) => {
                if (String(e.id) === slug) return true;
                if (!e.short_link) return false;
                const s = String(e.short_link).toLowerCase().replace(/\/$/, '');
                return s === slug || s.endsWith('/' + slug);
              });

              if (found && found.origin_link) {
                let dest = found.origin_link.trim();
                if (!dest.startsWith('http://') && !dest.startsWith('https://')) {
                  dest = 'https://' + dest;
                }
                window.location.replace(dest);
                return;
              }
            }
          }
        } catch (e) {
          console.error('[Redirect] Failed to query event destination:', e);
        }
      }

      // If not an event redirect or event not found, display friendly 404
      const spinner = document.getElementById('redirect-spinner');
      const notFound = document.getElementById('not-found-box');
      if (spinner) spinner.classList.add('hidden');
      if (notFound) notFound.classList.remove('hidden');
    };

    handleRedirect();
  </script>
</Layout>
