---
// AlurPemesanan.astro
---
<section id="alur-pemesanan" class="alur-pemesanan-wrapper relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-14">
      <span class="bg-[#89CFF0] text-white font-handwriting text-xl sm:text-2xl px-6 py-1.5 rounded-full shadow-md inline-block mb-3">
        Order Process
      </span>
      <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-text-dark">
        Custom Items Step-by-Step
      </h3>
      <p class="text-xs sm:text-sm text-text-muted mt-2">
        A transparent & easy process from concept until the order is in your hands.
      </p>
    </div>

    <!-- 8 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Step 1 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          01
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-pink-light/80 flex items-center justify-center text-pink-deep group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          </svg>
        </div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          R&D
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Discussion of requirements, design concepts, material selection, and desired product details.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          02
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-yellow-light/80 flex items-center justify-center text-yellow-dark group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Sampling
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Free sampling* is available, and the sample can be shipped for direct review.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          03
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-blue-soft/30 flex items-center justify-center text-blue-600 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
        </div>
        <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          50% Down Payment
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          A 50% down payment of the total order is required to begin production.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          04
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-pink-light/80 flex items-center justify-center text-pink-deep group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Mass Production
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Mass production is carried out according to the agreed specifications and timeline.
        </p>
      </div>

      <!-- Step 5 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          05
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-yellow-light/80 flex items-center justify-center text-yellow-dark group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Finish (QC)
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Production is completed, and the products undergo strict quality control before proceeding to the next stage.
        </p>
      </div>

      <!-- Step 6 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          06
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-blue-soft/30 flex items-center justify-center text-blue-600 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Final Payment
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          The remaining payment is made before the order is ready for delivery.
        </p>
      </div>

      <!-- Step 7 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          07
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-pink-light/80 flex items-center justify-center text-pink-deep group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Shipping
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          The order is shipped to the destination address with secure, neat, and attractive packaging.
        </p>
      </div>

      <!-- Step 8 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          08
        </span>
        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-yellow-light/80 flex items-center justify-center text-yellow-dark group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Feedback
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          We highly appreciate client reviews and feedback to continuously improve our work.
        </p>
      </div>

    </div>

    <!-- Free sampling footnote -->
    <div class="mt-8 text-center">
      <span class="inline-flex items-center gap-1.5 bg-white border border-pink-deep/30 px-5 py-2 rounded-full text-xs text-pink-deep font-heading font-semibold shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
        <span>*Free sampling applies to a minimum order of 100 pcs.</span>
      </span>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAlurPemesanan = () => {
    // Step cards stagger
    gsap.fromTo(
      '.step-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.6,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#alur-pemesanan',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.step-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAlurPemesanan);
  } else {
    initAlurPemesanan();
  }
</script>
