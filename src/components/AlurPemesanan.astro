---
// AlurPemesanan.astro
---
<section id="alur-pemesanan" class="alur-pemesanan-wrapper relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-14">
      <span class="bg-[#89CFF0] text-white font-handwriting text-xl sm:text-2xl px-6 py-1.5 rounded-full shadow-md inline-block mb-3">
        Order Process
      </span>
      <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-text-dark">
        Custom Items Step-by-Step
      </h3>
      <p class="text-xs sm:text-sm text-text-muted mt-2">
        A transparent & easy process from concept until the order is in your hands.
      </p>
    </div>

    <!-- 8 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Step 1 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          01
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📋</div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          R&D
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Discussion of requirements, design concepts, material selection, and desired product details.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          02
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📦</div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Sampling
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Free sampling* is available, and the sample can be shipped for direct review.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          03
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📱</div>
        <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          50% Down Payment
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          A 50% down payment of the total order is required to begin production.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          04
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">⚙️</div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Mass Production
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Mass production is carried out according to the agreed specifications and timeline.
        </p>
      </div>

      <!-- Step 5 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          05
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">✅</div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Finish (QC)
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          Production is completed, and the products undergo strict quality control before proceeding to the next stage.
        </p>
      </div>

      <!-- Step 6 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          06
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">🧾</div>
        <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Final Payment
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          The remaining payment is made before the order is ready for delivery.
        </p>
      </div>

      <!-- Step 7 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          07
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">🚚</div>
        <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Shipping
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          The order is shipped to the destination address with secure, neat, and attractive packaging.
        </p>
      </div>

      <!-- Step 8 -->
      <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
          08
        </span>
        <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">💌</div>
        <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
          Feedback
        </div>
        <p class="text-xs text-text-muted text-center leading-relaxed">
          We highly appreciate client reviews and feedback to continuously improve our work.
        </p>
      </div>

    </div>

    <!-- Free sampling footnote -->
    <div class="mt-8 text-center">
      <span class="inline-block bg-white border border-pink-deep/30 px-5 py-2 rounded-full text-xs text-pink-deep font-heading font-semibold shadow-sm">
        🌸 *Free sampling applies to a minimum order of 100 pcs.
      </span>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAlurPemesanan = () => {
    // Step cards stagger
    gsap.fromTo(
      '.step-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.6,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#alur-pemesanan',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.step-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAlurPemesanan);
  } else {
    initAlurPemesanan();
  }
</script>
