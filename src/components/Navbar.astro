---
// Navbar.astro
---
<header id="main-navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-3 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto bg-white/85 backdrop-blur-md border border-pink/40 shadow-sm rounded-full px-6 py-3 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-2.5 group">
      <img 
        src="/logo.png" 
        alt="Looca ID Logo" 
        class="w-10 h-10 rounded-full object-cover shadow-sm border-2 border-pink/60 group-hover:rotate-12 transition-transform"
      />
      <div class="flex flex-col">
        <span class="font-handwriting text-2xl font-bold text-pink-deep leading-none">looca_id</span>
        <span class="text-[10px] tracking-wider text-text-muted font-heading uppercase">Fashion - Accessories - Workshop</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-heading font-semibold text-text-dark">
      <a href="#home" class="hover:text-pink-deep transition-colors">Home</a>
      <a href="#about" class="hover:text-pink-deep transition-colors">About</a>
      <a href="#products" class="hover:text-pink-deep transition-colors">Products</a>
      <a href="#workshop" class="hover:text-pink-deep transition-colors">Workshop</a>
      <a href="#testimonials" class="hover:text-pink-deep transition-colors">Testimonial</a>
      <a href="#find-us" class="hover:text-pink-deep transition-colors">Find Us</a>
      <a href="#contact" class="hover:text-pink-deep transition-colors">Contact</a>
    </nav>

    <!-- Right Action Button -->
    <div class="hidden sm:flex items-center gap-3">
      <a 
        href="#contact" 
        class="bg-pink-deep hover:bg-pink-deep/90 text-white font-heading text-xs uppercase tracking-wider px-5 py-2.5 rounded-full shadow-md shadow-pink-deep/20 hover:scale-105 active:scale-95 transition-all flex items-center gap-1.5"
      >
        <span>Let's Connect</span>
        <span>✨</span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button 
      id="menu-toggle" 
      class="md:hidden w-10 h-10 rounded-full bg-yellow-light border border-yellow flex items-center justify-center text-text-dark focus:outline-none"
      aria-label="Toggle Navigation Menu"
    >
      <span class="text-xl">☰</span>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-dropdown" 
    class="hidden md:hidden mt-2 mx-auto max-w-sm bg-white/95 backdrop-blur-md rounded-3xl border border-pink/50 shadow-xl p-5 flex flex-col gap-3 font-heading font-medium text-center"
  >
    <a href="#home" class="py-2 hover:bg-pink-light rounded-xl transition-colors">Home</a>
    <a href="#about" class="py-2 hover:bg-pink-light rounded-xl transition-colors">About</a>
    <a href="#products" class="py-2 hover:bg-pink-light rounded-xl transition-colors">Products</a>
    <a href="#workshop" class="py-2 hover:bg-pink-light rounded-xl transition-colors">Workshop</a>
    <a href="#testimonials" class="py-2 hover:bg-pink-light rounded-xl transition-colors">Testimonials</a>
    <a href="#find-us" class="py-2 hover:bg-pink-light rounded-xl transition-colors">Find Us</a>
    <a href="#contact" class="py-2 bg-pink-deep text-white rounded-full font-bold shadow-sm">Contact</a>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const toggleBtn = document.getElementById('menu-toggle');
  const dropdown = document.getElementById('mobile-dropdown');
  const navLinks = dropdown?.querySelectorAll('a');

  toggleBtn?.addEventListener('click', () => {
    dropdown?.classList.toggle('hidden');
  });

  navLinks?.forEach(link => {
    link.addEventListener('click', () => {
      dropdown?.classList.add('hidden');
    });
  });
</script>
