---
// Collaboration.astro
const row1Partners = [
  { id: 1, logo: '/images/partners/1.JPG' },
  { id: 2, logo: '/images/partners/2.PNG' },
  { id: 3, logo: '/images/partners/3.PNG' },
  { id: 4, logo: '/images/partners/4.JPG' },
  { id: 5, logo: '/images/partners/5.PNG' },
  { id: 6, logo: '/images/partners/6.PNG' },
  { id: 7, logo: '/images/partners/7.AVIF' },
  { id: 8, logo: '/images/partners/8.PNG' },
  { id: 9, logo: '/images/partners/9.png' },
];

const row2Partners = [
  { id: 10, logo: '/images/partners/10.png' },
  { id: 11, logo: '/images/partners/11.png' },
  { id: 12, logo: '/images/partners/12.png' },
  { id: 13, logo: '/images/partners/13.png' },
  { id: 14, logo: '/images/partners/14.png' },
  { id: 15, logo: '/images/partners/15.png' },
  { id: 16, logo: '/images/partners/16.png' },
  { id: 17, logo: '/images/partners/17.png' },
  { id: 18, logo: '/images/partners/18.png' },
];
---

<section id="collaboration" class="relative py-16 sm:py-24 px-4 sm:px-8 bg-[#FFFDF9] border-y border-pink/30 overflow-hidden">
  <div class="max-w-6xl mx-auto text-center mb-10 sm:mb-12">
    <!-- Title & Slogan -->
    <div class="inline-block bg-yellow-light text-yellow-dark font-handwriting text-xl sm:text-2xl px-6 py-1 rounded-full shadow-sm mb-3">
      Together We Grow 🤝
    </div>
    <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-text-dark mb-4">
      Collaboration & Partnership
    </h2>
    <p class="text-xs sm:text-sm text-text-muted max-w-lg mx-auto">
      Trusted by institutions, well-known beauty brands, event organizers, and creative communities.
    </p>
  </div>

  <!-- Marquee Slider Container with Fade Masks -->
  <div class="relative w-full max-w-7xl mx-auto space-y-4 sm:space-y-6 overflow-hidden marquee-mask">
    
    <!-- Row 1: Left to Right (LTR) -->
    <div class="marquee-wrapper overflow-hidden py-1">
      <div class="marquee-track marquee-ltr flex items-center gap-4 sm:gap-6 w-max">
        <!-- Original List -->
        {row1Partners.map((partner) => (
          <div class="collab-card group bg-white px-5 py-4 rounded-2xl border border-pink/20 shadow-xs hover:shadow-md hover:border-pink transition-all duration-300 flex items-center justify-center w-36 h-24 sm:w-48 sm:h-28 flex-shrink-0">
            <img 
              src={partner.logo} 
              alt={`Partner logo ${partner.id}`}
              class="max-h-12 sm:max-h-16 w-auto max-w-full object-contain group-hover:scale-105 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
        <!-- Duplicated List for Infinite Loop -->
        {row1Partners.map((partner) => (
          <div class="collab-card group bg-white px-5 py-4 rounded-2xl border border-pink/20 shadow-xs hover:shadow-md hover:border-pink transition-all duration-300 flex items-center justify-center w-36 h-24 sm:w-48 sm:h-28 flex-shrink-0" aria-hidden="true">
            <img 
              src={partner.logo} 
              alt=""
              class="max-h-12 sm:max-h-16 w-auto max-w-full object-contain group-hover:scale-105 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Right to Left (RTL) -->
    <div class="marquee-wrapper overflow-hidden py-1">
      <div class="marquee-track marquee-rtl flex items-center gap-4 sm:gap-6 w-max">
        <!-- Original List -->
        {row2Partners.map((partner) => (
          <div class="collab-card group bg-white px-5 py-4 rounded-2xl border border-yellow/30 shadow-xs hover:shadow-md hover:border-yellow transition-all duration-300 flex items-center justify-center w-36 h-24 sm:w-48 sm:h-28 flex-shrink-0">
            <img 
              src={partner.logo} 
              alt={`Partner logo ${partner.id}`}
              class="max-h-12 sm:max-h-16 w-auto max-w-full object-contain group-hover:scale-105 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
        <!-- Duplicated List for Infinite Loop -->
        {row2Partners.map((partner) => (
          <div class="collab-card group bg-white px-5 py-4 rounded-2xl border border-yellow/30 shadow-xs hover:shadow-md hover:border-yellow transition-all duration-300 flex items-center justify-center w-36 h-24 sm:w-48 sm:h-28 flex-shrink-0" aria-hidden="true">
            <img 
              src={partner.logo} 
              alt=""
              class="max-h-12 sm:max-h-16 w-auto max-w-full object-contain group-hover:scale-105 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* Side gradient fade effect */
  .marquee-mask {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  /* Smooth Continuous Infinite Scroll */
  .marquee-ltr {
    animation: scroll-ltr 28s linear infinite;
  }

  .marquee-rtl {
    animation: scroll-rtl 28s linear infinite;
  }

  /* Pause when user hovers */
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scroll-ltr {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  @keyframes scroll-rtl {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
