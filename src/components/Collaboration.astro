---
// Collaboration.astro
---
<section id="collaboration" class="relative py-16 sm:py-20 px-4 sm:px-8 bg-white border-y border-pink/30 overflow-hidden">
  <div class="max-w-6xl mx-auto text-center">
    
    <!-- Title -->
    <div class="inline-block bg-yellow-light text-yellow-dark font-handwriting text-xl sm:text-2xl px-6 py-1 rounded-full shadow-sm mb-3">
      Together We Grow 🤝
    </div>
    <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-text-dark mb-4">
      Collaboration & Partnership
    </h2>
    <p class="text-xs sm:text-sm text-text-muted max-w-md mx-auto mb-12">
      Telah dipercaya oleh berbagai institusi, brand kecantikan, hingga komunitas ternama.
    </p>

    <!-- Partner Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6 items-center justify-center">
      
      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-pink-deep">IPB University</span>
        <span class="text-[10px] text-text-muted">Sekolah Vokasi</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-[#E75480]">emina</span>
        <span class="text-[10px] text-text-muted">Born to be Loved</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-text-dark">OMG!</span>
        <span class="text-[10px] text-text-muted">Oh My Glam</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-[#D4AF37]">HALA GOLD</span>
        <span class="text-[10px] text-text-muted">Jewellery Partner</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-red-500">Chupa Chups</span>
        <span class="text-[10px] text-text-muted">Special Collab</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-pink-500">Pink Rabbit</span>
        <span class="text-[10px] text-text-muted">Softlens & Beauty</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-blue-600">KlikBi</span>
        <span class="text-[10px] text-text-muted">Partner Media</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-green-600">SparksEnglish</span>
        <span class="text-[10px] text-text-muted">Education</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-purple-600">Let's Go Girls</span>
        <span class="text-[10px] text-text-muted">Community</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-pink-deep">The Bouquet</span>
        <span class="text-[10px] text-text-muted">Gift & Florist</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-amber-700">Shali Coffee</span>
        <span class="text-[10px] text-text-muted">F&B Partner</span>
      </div>

      <div class="collab-item bg-cream p-4 rounded-2xl border border-pink/20 flex flex-col items-center justify-center aspect-[3/2] shadow-xs hover:shadow-md hover:scale-105 transition-all">
        <span class="font-heading font-extrabold text-sm sm:text-base text-pink-600">atristuff</span>
        <span class="text-[10px] text-text-muted">Merchandise</span>
      </div>

    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.collab-item', {
      scrollTrigger: {
        trigger: '#collaboration',
        start: 'top 80%',
      },
      scale: 0.7,
      opacity: 0,
      stagger: 0.05,
      duration: 0.5,
      ease: 'back.out(1.5)'
    });
  });
</script>
