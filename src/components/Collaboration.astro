---
// Collaboration.astro
const majorPartners = [
  { name: 'IPB University', logo: '/images/partners/partner-ipb.png' },
  { name: 'KlikBi & SparksEnglish', logo: '/images/partners/partner-klikbi.png' },
  { name: 'Pink Rabbit Lens', logo: '/images/partners/partner-pinkrabbit.png' },
  { name: 'Chupa Chups', logo: '/images/partners/partner-chupachups.png' },
  { name: 'P Creative', logo: '/images/partners/partner-p.png' },
  { name: 'Emina Cosmetics', logo: '/images/partners/partner-emina.png' },
  { name: 'OMG Oh My Glam', logo: '/images/partners/partner-omg.png' },
  { name: 'Hala Gold', logo: '/images/partners/partner-halagold.png' },
];

const communityPartners = [
  { name: 'Kalato', logo: '/images/partners/partner-kalato.png' },
  { name: 'Sisi Teduh', logo: '/images/partners/partner-sisiteduh.png' },
  { name: 'Glosplum', logo: '/images/partners/partner-glosplum.png' },
  { name: 'The Bouquet', logo: '/images/partners/partner-thebouquet.png' },
  { name: 'atristuff', logo: '/images/partners/partner-atristuff.png' },
  { name: 'Juta Tawa', logo: '/images/partners/partner-jutatawa.png' },
  { name: 'Karen Wow', logo: '/images/partners/partner-karenwow.png' },
  { name: 'Shali Coffee', logo: '/images/partners/partner-shali.png' },
  { name: 'AIEC Educare', logo: '/images/partners/partner-aiec.png' },
  { name: 'Pink Emoji', logo: '/images/partners/partner-pinkemoji.png' },
  { name: 'Let\'s Go Girls', logo: '/images/partners/partner-letsgogirls.png' },
];
---

<section id="collaboration" class="relative py-16 sm:py-24 px-4 sm:px-8 bg-[#FFFDF9] border-y border-pink/30 overflow-hidden">
  <div class="max-w-6xl mx-auto text-center">
    
    <!-- Title & Slogan -->
    <div class="inline-block bg-yellow-light text-yellow-dark font-handwriting text-xl sm:text-2xl px-6 py-1 rounded-full shadow-sm mb-3">
      Together We Grow 🤝
    </div>
    <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-text-dark mb-4">
      Collaboration & Partnership
    </h2>
    <p class="text-xs sm:text-sm text-text-muted max-w-lg mx-auto mb-12">
      Telah dipercaya oleh berbagai institusi, brand kecantikan ternama, event organizer, hingga komunitas kreatif.
    </p>

    <!-- Row 1: Major Institutional & Brand Partners -->
    <div class="mb-8">
      <span class="text-xs font-heading font-bold uppercase tracking-wider text-text-muted/80 block mb-5">
        Brand & Institutional Partners
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 sm:gap-4 items-center justify-center">
        {majorPartners.map((partner) => (
          <div class="collab-item group bg-white p-3 rounded-2xl border border-pink/25 shadow-xs hover:shadow-md hover:border-pink transition-all flex items-center justify-center aspect-[4/3] relative">
            <img 
              src={partner.logo} 
              alt={partner.name}
              title={partner.name}
              class="max-h-12 w-auto max-w-full object-contain group-hover:scale-110 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Community & Creative Partners -->
    <div>
      <span class="text-xs font-heading font-bold uppercase tracking-wider text-text-muted/80 block mb-5">
        Community & Creative Collaborators
      </span>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-11 gap-3 sm:gap-3.5 items-center justify-center">
        {communityPartners.map((partner) => (
          <div class="collab-item group bg-white p-2.5 rounded-2xl border border-yellow/30 shadow-xs hover:shadow-md hover:border-yellow transition-all flex items-center justify-center aspect-square relative">
            <img 
              src={partner.logo} 
              alt={partner.name}
              title={partner.name}
              class="max-h-11 w-auto max-w-full object-contain group-hover:scale-115 transition-transform duration-300" 
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initCollab = () => {
    gsap.fromTo(
      '.collab-item',
      { opacity: 0, scale: 0.85, y: 15 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        stagger: 0.03,
        duration: 0.5,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#collaboration',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.collab-item').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCollab);
  } else {
    initCollab();
  }
</script>
