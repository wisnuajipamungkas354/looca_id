---

<section id="products" class="relative py-16 sm:py-20 lg:py-28 px-3 sm:px-8 bg-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 bg-yellow text-text-dark font-handwriting text-lg sm:text-2xl px-5 sm:px-6 py-1.5 rounded-full shadow-md -rotate-1 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 text-text-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span>Catalog & Gallery</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-extrabold text-text-dark tracking-tight">
        Our Products & Gallery
      </h2>
      <p class="text-text-muted mt-2 sm:mt-3 max-w-lg mx-auto text-xs sm:text-base">
        Explore our curated handmade creations, from daily accessories to custom fashion and bulk souvenir orders.
      </p>
    </div>

    <!-- Interactive E-Commerce Category Tabs -->
    <div class="flex items-center justify-start sm:justify-center gap-1.5 sm:gap-3 overflow-x-auto pb-3 pt-1 mb-8 sm:mb-12 no-scrollbar px-1">
      {categories.map((cat, index) => (
        <button
          type="button"
          data-tab={cat.id}
          class={`tab-btn shrink-0 flex items-center gap-1.5 sm:gap-2 font-heading font-bold text-xs sm:text-sm px-4 sm:px-6 py-2 sm:py-3 rounded-full transition-all duration-300 cursor-pointer ${
            index === 0
              ? 'active bg-pink-deep text-white shadow-md shadow-pink-deep/20 scale-105'
              : 'bg-white/90 text-text-dark border border-pink/20 shadow-xs'
          }`}
        >
          <span class="inline-flex items-center" set:html={cat.iconSvg} />
          <span>{cat.label}</span>
        </button>
      ))}
    </div>

    <!-- E-Commerce Product Cards Grid (2 Columns on Mobile, 3 on Tablet/Laptop, 4 on Large Screens) -->
    <div id="product-grid" class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-6">
      {products.map((product) => (
        <div 
          class="product-item group bg-white rounded-2xl sm:rounded-3xl p-3 sm:p-4 border border-pink/25 shadow-xs hover:shadow-xl hover:border-pink/50 transition-all duration-300 flex flex-col justify-between"
          data-category={product.category}
        >
          <!-- Top Area: Image Showcase with Badges and Slide Support -->
          <div>
            <div 
              class="product-image-wrapper relative w-full aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-cream/50 mb-2.5 sm:mb-4"
              data-slides-count={product.images.length}
            >
              <!-- Seamless One-Way Infinite Slider Track -->
              <div class="product-slider-track flex w-full h-full">
                {product.images.map((img, idx) => (
                  <div class="w-full h-full flex-shrink-0 relative overflow-hidden">
                    <img 
                      src={img} 
                      alt={`${product.title} - ${idx + 1}`} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                      loading="lazy"
                    />
                  </div>
                ))}
                {/* Clone first image at the end for seamless continuous forward loop */}
                {product.images.length > 1 && (
                  <div class="w-full h-full flex-shrink-0 relative overflow-hidden" aria-hidden="true">
                    <img 
                      src={product.images[0]} 
                      alt={`${product.title} - clone`} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                      loading="lazy"
                    />
                  </div>
                )}
              </div>

              <!-- Slide Dots Indicator (For multi-image products) -->
              {product.images.length > 1 && (
                <div class="slider-dots absolute bottom-2 sm:bottom-2.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full bg-black/35 backdrop-blur-sm pointer-events-none">
                  {product.images.map((_, idx) => (
                    <span 
                      class={`slider-dot block rounded-full transition-all duration-300 ${idx === 0 ? 'w-3 sm:w-4 h-1 sm:h-1.5 bg-white shadow-xs' : 'w-1 sm:w-1.5 h-1 sm:h-1.5 bg-white/50'}`}
                      data-dot-index={idx}
                    ></span>
                  ))}
                </div>
              )}
              
              <!-- Floating Top Tag -->
              <div class="absolute top-2 left-2 sm:top-3 sm:left-3 z-10">
                <span class={`font-heading font-extrabold text-[8px] sm:text-[11px] px-2 sm:px-3 py-0.5 sm:py-1 rounded-full shadow-sm ${product.badgeColor}`}>
                  {product.badge}
                </span>
              </div>

              <!-- Wishlist Heart SVG Icon -->
              <div class="absolute top-2 right-2 sm:top-3 sm:right-3 z-10 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white/85 backdrop-blur-sm border border-pink/20 flex items-center justify-center text-pink-deep shadow-xs group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-4 sm:h-4 fill-pink-deep" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </div>

              <!-- Overlay Gradient on Hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
            </div>

            <!-- Category & Rating -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-0.5 sm:gap-1.5 mb-1 sm:mb-1.5 px-0.5 sm:px-1">
              <span class="text-[9px] sm:text-[11px] font-heading font-semibold uppercase tracking-wider text-pink-deep">
                {product.categoryLabel}
              </span>
              <div class="flex items-center gap-1 text-[9px] sm:text-[11px] font-heading font-bold text-yellow-dark">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 fill-current text-yellow-dark shrink-0" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span class="shrink-0">{product.rating}</span>
                <span class="text-text-muted font-normal text-[9px] sm:text-[11px] truncate whitespace-nowrap" title={product.sales}>
                  ({product.sales})
                </span>
              </div>
            </div>

            <!-- Product Title -->
            <h3 class="font-heading font-bold text-xs sm:text-base text-text-dark leading-snug mb-1 sm:mb-2 px-0.5 sm:px-1 group-hover:text-pink-deep transition-colors line-clamp-1 group-hover:line-clamp-none" title={product.title}>
              {product.title}
            </h3>

            <!-- Product Description -->
            <p class="text-[10px] sm:text-xs text-text-muted leading-relaxed mb-3 sm:mb-4 px-0.5 sm:px-1 line-clamp-2 group-hover:line-clamp-none transition-all duration-300">
              {product.description}
            </p>
          </div>

          <!-- Bottom Action Button (E-Commerce CTA) -->
          <div class="pt-2.5 sm:pt-3 border-t border-gray-100 mt-auto">
            <a 
              href={product.actionLink}
              class="w-full bg-yellow-light hover:bg-yellow text-text-dark font-heading font-bold text-[10px] sm:text-xs py-2 sm:py-2.5 px-2 sm:px-4 rounded-lg sm:rounded-xl shadow-xs hover:shadow-md flex items-center justify-center gap-1.5 sm:gap-2 hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              <span>{product.actionText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-text-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Empty State Fallback (Hidden by default) -->
    <div id="empty-state" class="hidden text-center py-16">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto text-pink-deep mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      <h4 class="font-heading font-bold text-lg text-text-dark">No products found in this category</h4>
      <p class="text-xs text-text-muted mt-1">Please check back soon or inquire custom order.</p>
    </div>

  </div>
</section>

<style>
  /* Hide scrollbar for category tabs */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Smooth tab transition */
  .product-item {
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .product-item.hidden-item {
    display: none;
    opacity: 0;
    transform: scale(0.95);
  }

  /* Slider track */
  .product-slider-track {
    will-change: transform;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initProductHoverSliders = () => {
    const productCards = document.querySelectorAll<HTMLElement>('.product-item');

    productCards.forEach((card) => {
      const track = card.querySelector<HTMLElement>('.product-slider-track');
      const wrapper = card.querySelector<HTMLElement>('.product-image-wrapper');
      const dots = card.querySelectorAll<HTMLElement>('.slider-dot');
      
      if (!track || !wrapper) return;
      
      const realCount = parseInt(wrapper.getAttribute('data-slides-count') || '1', 10);
      if (realCount <= 1) return;

      let currentIndex = 0;
      let timer: number | null = null;
      let isSliding = false;

      // Update dot active indicator
      const updateDots = (index: number) => {
        const activeDotIdx = index % realCount;
        dots.forEach((dot, idx) => {
          if (idx === activeDotIdx) {
            dot.classList.remove('w-1.5', 'bg-white/50');
            dot.classList.add('w-4', 'bg-white', 'shadow-xs');
          } else {
            dot.classList.remove('w-4', 'bg-white', 'shadow-xs');
            dot.classList.add('w-1.5', 'bg-white/50');
          }
        });
      };

      // Slide forward seamlessly in ONE direction without reversing
      const slideNext = () => {
        if (isSliding) return;
        isSliding = true;
        currentIndex++;

        track.style.transition = 'transform 550ms cubic-bezier(0.25, 1, 0.5, 1)';
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
        updateDots(currentIndex);

        // When reaching the cloned first image at the end
        if (currentIndex === realCount) {
          setTimeout(() => {
            // Seamlessly snap back to actual first image with no transition
            track.style.transition = 'none';
            currentIndex = 0;
            track.style.transform = `translateX(0%)`;
            // Trigger reflow to apply transition: none
            void track.offsetWidth;
            isSliding = false;
          }, 550);
        } else {
          setTimeout(() => {
            isSliding = false;
          }, 550);
        }
      };

      const startSliding = () => {
        if (timer) clearInterval(timer);
        // Slide to next image immediately on hover
        slideNext();
        // Continue sliding forward continuously in one direction
        timer = window.setInterval(() => {
          slideNext();
        }, 1800);
      };

      const stopSliding = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      card.addEventListener('mouseenter', startSliding);
      card.addEventListener('mouseleave', stopSliding);
    });
  };

  const initProductTabs = () => {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const productItems = document.querySelectorAll<HTMLElement>('.product-item');
    const emptyState = document.getElementById('empty-state');

    // Initial GSAP reveal
    gsap.fromTo(
      '.product-item',
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.05,
        duration: 0.5,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#products',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Tab Click Filtering Logic
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-tab');

        // Update Active Button Style
        tabBtns.forEach((b) => {
          b.classList.remove('active', 'bg-pink-deep', 'text-white', 'shadow-md', 'shadow-pink-deep/20', 'scale-105');
          b.classList.add('bg-white/90', 'text-text-dark', 'border', 'border-pink/20', 'shadow-xs');
        });

        btn.classList.add('active', 'bg-pink-deep', 'text-white', 'shadow-md', 'shadow-pink-deep/20', 'scale-105');
        btn.classList.remove('bg-white/90', 'text-text-dark', 'border', 'border-pink/20', 'shadow-xs');

        // Filter Products
        let visibleCount = 0;
        productItems.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');

          if (targetCategory === 'all' || itemCategory === targetCategory) {
            item.classList.remove('hidden-item');
            visibleCount++;
          } else {
            item.classList.add('hidden-item');
          }
        });

        // Show/Hide Empty State
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }

        // Animate newly visible items
        const visibleItems = document.querySelectorAll('.product-item:not(.hidden-item)');
        gsap.fromTo(
          visibleItems,
          { opacity: 0, scale: 0.95, y: 15 },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            stagger: 0.04,
            duration: 0.4,
            ease: 'back.out(1.2)',
            clearProps: 'all',
          }
        );
      });
    });

    // Initialize Hover Sliders for multi-image cards
    initProductHoverSliders();

    // Failsafe: Ensure visible items are never stuck invisible
    setTimeout(() => {
      document.querySelectorAll('.product-item:not(.hidden-item)').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductTabs);
  } else {
    initProductTabs();
  }
</script>
