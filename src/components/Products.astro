---
// Products.astro
---
<section id="products" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark">
        Our Products & Gallery
      </h2>
      <p class="text-text-muted mt-3 max-w-lg mx-auto text-sm sm:text-base">
        From personal fashion and accessory items to white-label products and bulk souvenir orders.
      </p>
    </div>

    <!-- Category 1: Fashion -->
    <div class="mb-16">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-text-dark flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-yellow-dark"></span>
          Fashion
        </h3>
        <span class="text-xs font-heading font-semibold text-yellow-dark bg-yellow-light px-3 py-1 rounded-full">
          Bulk Order Available
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Wedding Souvenir -->
        <div class="souvenir-card bg-white p-4 sm:p-5 rounded-3xl border border-yellow/40 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
          <div class="absolute top-6 right-6 sm:top-7 sm:right-7 z-10 bg-yellow text-text-dark font-heading font-extrabold text-xs px-3 sm:px-3.5 py-1 rounded-full shadow-md">
            300 PCS+
          </div>
          <div class="h-44 sm:h-48 rounded-2xl overflow-hidden mb-4 relative">
            <img 
              src="/images/souvenir-wedding.jpg" 
              alt="Wedding Souvenir" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-4">
              <span class="font-handwriting text-2xl text-white drop-shadow">Wedding Edition</span>
            </div>
          </div>
          <h4 class="font-heading font-bold text-lg text-text-dark mb-1">Pernikahan & Tunangan</h4>
          <p class="text-xs text-text-muted">Aksesori eksklusif dengan custom tag nama pengantin yang manis dan berkesan.</p>
        </div>

        <!-- Corporate / Institution Souvenir -->
        <div class="souvenir-card bg-white p-4 sm:p-5 rounded-3xl border border-pink/40 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
          <div class="absolute top-6 right-6 sm:top-7 sm:right-7 z-10 bg-pink-deep text-white font-heading font-extrabold text-xs px-3 sm:px-3.5 py-1 rounded-full shadow-md">
            1000 PCS+
          </div>
          <div class="h-44 sm:h-48 rounded-2xl overflow-hidden mb-4 relative">
            <img 
              src="/images/souvenir-corporate.jpg" 
              alt="Corporate Souvenir" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-4">
              <span class="font-handwriting text-2xl text-white drop-shadow">Institution & Brand</span>
            </div>
          </div>
          <h4 class="font-heading font-bold text-lg text-text-dark mb-1">Institusi & Perusahaan</h4>
          <p class="text-xs text-text-muted">Merchandise seminar, workshop, dies natalis, dan event promosi brand berskala besar.</p>
        </div>

      </div>
    </div>

    <!-- Category 2: Accessories & Bagcharms -->
    <div class="mb-16">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-text-dark flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-pink-deep"></span>
          Accessories & Bagcharms
        </h3>
        <span class="text-xs font-heading font-semibold text-pink-deep bg-pink-light px-3 py-1 rounded-full">
          Handmade • Stainless
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- Item 1: Beaded Rings -->
        <div class="product-card group bg-white p-3 rounded-2xl border border-pink/30 shadow-sm hover:shadow-md transition-all">
          <div class="aspect-square rounded-xl overflow-hidden relative mb-2">
            <img 
              src="/images/product-beaded-rings.jpg" 
              alt="Beaded Rings" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            <span class="absolute top-2 left-2 bg-pink-deep/90 text-white font-heading text-[10px] px-2 py-0.5 rounded-full">
              Custom Ring
            </span>
          </div>
          <div class="text-center">
            <span class="font-heading font-bold text-xs sm:text-sm text-text-dark block">Beaded Rings</span>
            <span class="text-[11px] text-text-muted font-sans">Floral collection</span>
          </div>
        </div>

        <!-- Item 2: Charm Bracelet -->
        <div class="product-card group bg-white p-3 rounded-2xl border border-pink/30 shadow-sm hover:shadow-md transition-all">
          <div class="aspect-square rounded-xl overflow-hidden relative mb-2">
            <img 
              src="/images/product-charm-bracelet.jpg" 
              alt="Charm Bracelet" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            <span class="absolute top-2 left-2 bg-yellow-dark text-white font-heading text-[10px] px-2 py-0.5 rounded-full">
              Best Seller
            </span>
          </div>
          <div class="text-center">
            <span class="font-heading font-bold text-xs sm:text-sm text-text-dark block">Charm Bracelet</span>
            <span class="text-[11px] text-text-muted font-sans">Stainless steel</span>
          </div>
        </div>

        <!-- Item 3: Phone Strap -->
        <div class="product-card group bg-white p-3 rounded-2xl border border-pink/30 shadow-sm hover:shadow-md transition-all">
          <div class="aspect-square rounded-xl overflow-hidden relative mb-2">
            <img 
              src="/images/product-phone-strap.jpg" 
              alt="Phone Strap" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            <span class="absolute top-2 left-2 bg-blue-500 text-white font-heading text-[10px] px-2 py-0.5 rounded-full">
              Trending
            </span>
          </div>
          <div class="text-center">
            <span class="font-heading font-bold text-xs sm:text-sm text-text-dark block">Phone Strap</span>
            <span class="text-[11px] text-text-muted font-sans">Custom beads</span>
          </div>
        </div>

        <!-- Item 4: Hair Claw -->
        <div class="product-card group bg-white p-3 rounded-2xl border border-pink/30 shadow-sm hover:shadow-md transition-all">
          <div class="aspect-square rounded-xl overflow-hidden relative mb-2">
            <img 
              src="/images/product-hair-claw.jpg" 
              alt="Hair Claw" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
            />
            <span class="absolute top-2 left-2 bg-pink-deep/90 text-white font-heading text-[10px] px-2 py-0.5 rounded-full">
              Cute Pastel
            </span>
          </div>
          <div class="text-center">
            <span class="font-heading font-bold text-xs sm:text-sm text-text-dark block">Hair Claw</span>
            <span class="text-[11px] text-text-muted font-sans">Flower accents</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Category 3: Souvenir / Merchandise with Qty Badges -->
    <div class="mb-16">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-text-dark flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-yellow-dark"></span>
          Souvenir & Custom Merchandise
        </h3>
        <span class="text-xs font-heading font-semibold text-yellow-dark bg-yellow-light px-3 py-1 rounded-full">
          Bulk Order Available
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Wedding Souvenir -->
        <div class="souvenir-card bg-white p-4 sm:p-5 rounded-3xl border border-yellow/40 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
          <div class="absolute top-6 right-6 sm:top-7 sm:right-7 z-10 bg-yellow text-text-dark font-heading font-extrabold text-xs px-3 sm:px-3.5 py-1 rounded-full shadow-md">
            300 PCS+
          </div>
          <div class="h-44 sm:h-48 rounded-2xl overflow-hidden mb-4 relative">
            <img 
              src="/images/souvenir-wedding.jpg" 
              alt="Wedding Souvenir" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-4">
              <span class="font-handwriting text-2xl text-white drop-shadow">Wedding Edition</span>
            </div>
          </div>
          <h4 class="font-heading font-bold text-lg text-text-dark mb-1">Pernikahan & Tunangan</h4>
          <p class="text-xs text-text-muted">Aksesori eksklusif dengan custom tag nama pengantin yang manis dan berkesan.</p>
        </div>

        <!-- Corporate / Institution Souvenir -->
        <div class="souvenir-card bg-white p-4 sm:p-5 rounded-3xl border border-pink/40 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
          <div class="absolute top-6 right-6 sm:top-7 sm:right-7 z-10 bg-pink-deep text-white font-heading font-extrabold text-xs px-3 sm:px-3.5 py-1 rounded-full shadow-md">
            1000 PCS+
          </div>
          <div class="h-44 sm:h-48 rounded-2xl overflow-hidden mb-4 relative">
            <img 
              src="/images/souvenir-corporate.jpg" 
              alt="Corporate Souvenir" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-4">
              <span class="font-handwriting text-2xl text-white drop-shadow">Institution & Brand</span>
            </div>
          </div>
          <h4 class="font-heading font-bold text-lg text-text-dark mb-1">Institusi & Perusahaan</h4>
          <p class="text-xs text-text-muted">Merchandise seminar, workshop, dies natalis, dan event promosi brand berskala besar.</p>
        </div>

        <!-- Concert / Event Souvenir -->
        <div class="souvenir-card bg-white p-4 sm:p-5 rounded-3xl border border-blue-soft/40 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
          <div class="absolute top-6 right-6 sm:top-7 sm:right-7 z-10 bg-[#89CFF0] text-white font-heading font-extrabold text-xs px-3 sm:px-3.5 py-1 rounded-full shadow-md">
            2500 PCS+
          </div>
          <div class="h-44 sm:h-48 rounded-2xl overflow-hidden mb-4 relative">
            <img 
              src="/images/souvenir-concert.jpg" 
              alt="Concert & Event Souvenir" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent flex items-end p-4">
              <span class="font-handwriting text-2xl text-white drop-shadow">Concert Edition</span>
            </div>
          </div>
          <h4 class="font-heading font-bold text-lg text-text-dark mb-1">Concert & Fan Merch</h4>
          <p class="text-xs text-text-muted">Freebies konser, strap lightstick, dan merchandise fan event berskala ribuan pcs.</p>
        </div>
      </div>
    </div>

    <!-- Category 3: Channels (Offline Events, Online & International Delivery) -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-pink/30 shadow-sm">
      <h3 class="font-heading text-lg sm:text-xl font-bold text-text-dark mb-6 text-center">
        Tersedia di Berbagai Channel 🌍
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-4 rounded-2xl bg-cream border border-pink/20 flex flex-col items-center text-center">
          <div class="w-full h-32 rounded-xl overflow-hidden mb-3">
            <img 
              src="/images/channel-offline.jpg" 
              alt="Offline Store & Events" 
              class="w-full h-full object-cover hover:scale-105 transition-transform" 
            />
          </div>
          <h4 class="font-heading font-bold text-sm text-text-dark">Offline Store & Events</h4>
          <p class="text-xs text-text-muted mt-1">Hadir di berbagai creative market, bazar, dan pop-up booth.</p>
        </div>

        <div class="p-4 rounded-2xl bg-cream border border-yellow/20 flex flex-col items-center text-center">
          <div class="w-full h-32 rounded-xl overflow-hidden mb-3">
            <img 
              src="/images/channel-online.jpg" 
              alt="Nasional Online Store" 
              class="w-full h-full object-cover hover:scale-105 transition-transform" 
            />
          </div>
          <h4 class="font-heading font-bold text-sm text-text-dark">Nasional Online Store</h4>
          <p class="text-xs text-text-muted mt-1">Pengiriman aman ke seluruh penjuru Indonesia via Shopee & WA.</p>
        </div>

        <div class="p-4 rounded-2xl bg-cream border border-blue-soft/20 flex flex-col items-center text-center">
          <div class="w-full h-32 rounded-xl overflow-hidden mb-3">
            <img 
              src="/images/channel-shipping.jpg" 
              alt="International Shipping" 
              class="w-full h-full object-cover hover:scale-105 transition-transform" 
            />
          </div>
          <h4 class="font-heading font-bold text-sm text-text-dark">International Shipping</h4>
          <p class="text-xs text-text-muted mt-1">Telah mengirim pesanan hingga mancanegara (Singapore, dll).</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initProducts = () => {
    // Reveal product cards
    gsap.fromTo(
      '.product-card',
      { opacity: 0, scale: 0.9, y: 20 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        stagger: 0.06,
        duration: 0.6,
        ease: 'back.out(1.4)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#products',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Reveal souvenir cards
    gsap.fromTo(
      '.souvenir-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        duration: 0.6,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.souvenir-card',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe: Ensure everything is always 100% visible even if scroll calculation lags
    setTimeout(() => {
      document.querySelectorAll('.product-card, .souvenir-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProducts);
  } else {
    initProducts();
  }
</script>
