---
// Hero.astro
---
<section id="hero" class="relative min-h-[95vh] lg:min-h-screen pt-28 pb-24 px-4 flex flex-col items-center justify-center overflow-hidden bg-gradient-to-b from-[#FCE8ED] via-[#FFF3E8] to-[#FFFDF9]">
  <!-- Subtle craft background texture like the original store photo -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.08] mix-blend-multiply">
    <img 
      src="https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=1600&q=70" 
      alt="Craft Table Background" 
      class="w-full h-full object-cover" 
    />
  </div>

  <!-- Top Scallop Border (like original) -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 opacity-90">
    <img src="/src/assets/decorations/wave-yellow.svg" alt="wave decoration" class="w-full h-8 sm:h-12 object-cover object-top" />
  </div>

  <!-- Floating Cute Decorative Stickers (Background Doodles) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Star Doodle Left -->
    <div class="hero-sticker absolute top-28 left-4 sm:left-14 w-16 sm:w-28 -rotate-12 animate-float">
      <img src="/src/assets/decorations/star.svg" alt="star" class="w-full drop-shadow-md" />
    </div>

    <!-- Heart Doodle Right -->
    <div class="hero-sticker absolute top-32 right-4 sm:right-16 w-16 sm:w-28 rotate-12 animate-float" style="animation-delay: 1s;">
      <img src="/src/assets/decorations/heart.svg" alt="heart" class="w-full drop-shadow-md" />
    </div>

    <!-- Daisy Flower Bottom Left -->
    <div class="hero-sticker absolute bottom-24 left-8 sm:left-24 w-16 sm:w-24 animate-spin-slow">
      <img src="/src/assets/decorations/flower-daisy.svg" alt="daisy" class="w-full drop-shadow" />
    </div>

    <!-- Cherry Doodle Bottom Right -->
    <div class="hero-sticker absolute bottom-24 right-8 sm:right-28 w-16 sm:w-24 rotate-6 animate-float" style="animation-delay: 1.5s;">
      <img src="/src/assets/decorations/cherry.svg" alt="cherry" class="w-full drop-shadow" />
    </div>
  </div>

  <!-- Main Hero Content -->
  <div class="relative z-20 max-w-5xl mx-auto text-center flex flex-col items-center">
    <!-- Welcome Speech Bubble -->
    <div class="hero-bubble inline-flex items-center gap-2 bg-[#89CFF0] text-white font-handwriting text-xl sm:text-3xl px-7 py-2.5 rounded-full shadow-lg border-2 border-white -rotate-2 mb-4">
      <span>Hi! Welcome to our home!</span>
      <span class="text-xl">✨</span>
    </div>

    <!-- Central Looca Studio Flower Emblem (ENLARGED) -->
    <div class="hero-flower relative my-2 w-72 sm:w-[440px] md:w-[520px] lg:w-[580px] xl:w-[620px] transition-transform duration-500 hover:scale-105 cursor-pointer flex items-center justify-center">
      <img 
        src="/src/assets/decorations/flower-looca.svg" 
        alt="Looca Studio Flower" 
        class="w-full drop-shadow-2xl filter"
      />
    </div>

    <!-- Tagline & Description -->
    <div class="hero-text mt-6 max-w-xl">
      <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark tracking-tight leading-tight">
        Handmade with Love, <br class="hidden sm:inline"/> Crafted for Your Story
      </h1>
      <p class="font-sans text-base sm:text-lg text-text-muted mt-4 leading-relaxed">
        Accessories unik, merchandise kreatif, dan pengalaman workshop menyenangkan yang membawa keceriaan ke setiap momenmu.
      </p>
    </div>

    <!-- CTA Buttons -->
    <div class="hero-cta mt-8 flex flex-wrap items-center justify-center gap-4">
      <a 
        href="#products" 
        class="bg-pink-deep hover:bg-pink-deep/90 text-white font-heading font-bold text-base px-8 py-3.5 rounded-full shadow-lg shadow-pink-deep/30 hover:scale-105 active:scale-95 transition-all flex items-center gap-2"
      >
        <span>Explore Products</span>
        <span>🌸</span>
      </a>
      <a 
        href="#about" 
        class="bg-white/90 hover:bg-white text-text-dark font-heading font-semibold text-base px-7 py-3.5 rounded-full shadow-md border border-pink/40 hover:scale-105 active:scale-95 transition-all"
      >
        Tentang Looca
      </a>
    </div>
  </div>

  <!-- Bottom Wave Transition to About Section -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10">
    <img src="/src/assets/decorations/wave-pink.svg" alt="pink wave divider" class="w-full h-12 sm:h-20 object-cover object-bottom" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Bubble pop-in
    gsap.from('.hero-bubble', {
      scale: 0,
      opacity: 0,
      duration: 0.8,
      ease: 'back.out(1.8)',
      delay: 0.2
    });

    // Central Flower entrance
    gsap.from('.hero-flower', {
      scale: 0.2,
      rotation: -30,
      opacity: 0,
      duration: 1.2,
      ease: 'elastic.out(1, 0.6)',
      delay: 0.4
    });

    // Text and CTA entrance
    gsap.from(['.hero-text', '.hero-cta'], {
      y: 40,
      opacity: 0,
      duration: 0.9,
      stagger: 0.2,
      ease: 'power3.out',
      delay: 0.8
    });

    // Floating stickers entrance
    gsap.from('.hero-sticker', {
      scale: 0,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: 'back.out(2)',
      delay: 1.0
    });
  });
</script>
