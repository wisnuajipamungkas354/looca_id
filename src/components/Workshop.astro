---
// Workshop.astro
---
<section id="workshop" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-gradient-to-b from-white via-[#FFF0F5] to-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="inline-block bg-pink-deep text-white font-handwriting text-xl sm:text-2xl px-6 py-1.5 rounded-full shadow-md rotate-1 mb-3">
        Creative Experience 🎨
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark">
        Creative Workshop & Events
      </h2>
      <p class="text-text-muted mt-3 max-w-xl mx-auto text-sm sm:text-base">
        Menghubungkan orang-orang melalui sesi merangkai manik-manik, eksplorasi kreasi, dan kebahagiaan berkarya bersama.
      </p>
    </div>

    <!-- Gallery Grid 1: Scrapbook Photo Grid (like Screenshot 2) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 mb-14">
      <!-- Photo 1: Workshop Table & Beads -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-1.jpg" 
          alt="Workshop Craft Table" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-pink-deep/80 px-2 py-1 rounded-full">DIY Beads</span>
        </div>
      </div>

      <!-- Photo 2: Participants Smiling -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-2.jpg" 
          alt="Participants Smiling" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-yellow-dark/90 px-2 py-1 rounded-full">Fun Vibes</span>
        </div>
      </div>

      <!-- Photo 3: Hands-on Mentoring -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-3.jpg" 
          alt="Hands-on Mentoring" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-blue-500/80 px-2 py-1 rounded-full">Mentoring</span>
        </div>
      </div>

      <!-- Photo 4: Community Gathering -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-4.jpg" 
          alt="Community Gathering" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-pink-deep/80 px-2 py-1 rounded-full">Creative Team</span>
        </div>
      </div>

      <!-- Photo 5: Kids & DIY Activity -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-5.jpg" 
          alt="Kids Craft Workshop" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-yellow-dark/90 px-2 py-1 rounded-full">Kids DIY</span>
        </div>
      </div>

      <!-- Photo 6: Assembling Craft Detail -->
      <div class="workshop-thumb rounded-2xl overflow-hidden shadow-sm aspect-square relative group">
        <img 
          src="/images/workshop-6.jpg" 
          alt="Assembling Crafts" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
          <span class="text-white text-xs font-heading font-bold bg-pink-deep/80 px-2 py-1 rounded-full">Handmade</span>
        </div>
      </div>
    </div>

    <!-- Featured Scrapbook Bento Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Card 1: Corporate / Brand Activation -->
      <div class="workshop-photo relative bg-white p-4 rounded-3xl shadow-md border-2 border-pink/30 hover:rotate-0 -rotate-1 transition-all duration-300 group">
        <!-- Washi tape sticker top -->
        <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 w-20 sm:w-24 h-5 sm:h-6 bg-yellow/90 -rotate-2 rounded-sm shadow-xs z-20"></div>
        <div class="h-52 sm:h-60 rounded-2xl overflow-hidden relative shadow-inner">
          <img 
            src="/images/workshop-2.jpg" 
            alt="Pink Rabbit Lens Workshop" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-4 text-white">
            <span class="bg-pink-deep self-start text-white text-[11px] font-heading font-bold px-3 py-0.5 rounded-full mb-1">
              Corporate / Brand Activation
            </span>
            <h4 class="font-heading font-bold text-base">Pink Rabbit Lens</h4>
          </div>
        </div>
        <div class="pt-4 pb-2 px-2">
          <p class="text-xs text-text-muted mt-1 leading-relaxed">
            Creating engaging workshops and immersive brand activations for communities, fandoms, and brands to connect, create, and celebrate together.
          </p>
        </div>
      </div>

      <!-- Card 2: International Session -->
      <div class="workshop-photo relative bg-white p-4 rounded-3xl shadow-md border-2 border-blue-soft/50 hover:rotate-0 rotate-2 transition-all duration-300 group">
        <!-- Washi tape -->
        <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 w-20 sm:w-24 h-5 sm:h-6 bg-pink/90 rotate-2 rounded-sm shadow-xs z-20"></div>
        <div class="h-52 sm:h-60 rounded-2xl overflow-hidden relative shadow-inner">
          <img 
            src="/images/workshop-3.jpg" 
            alt="Klikbi SV IPB Workshop" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-4 text-white">
            <span class="bg-blue-500 self-start text-white text-[11px] font-heading font-bold px-3 py-0.5 rounded-full mb-1">
              International Session
            </span>
            <h4 class="font-heading font-bold text-sm sm:text-base leading-snug">In Collaboration with Klikbi SV IPB for</h4>
          </div>
        </div>
        <div class="pt-4 pb-2 px-2">
          <h4 class="font-heading font-bold text-sm text-text-dark">Cultural Exchange & Creativity</h4>
          <p class="text-xs text-text-muted mt-1 leading-relaxed">
            A hands-on interactive session connecting international students and faculty through Indonesian culture and craftsmanship.
          </p>
        </div>
      </div>

      <!-- Card 3: Private Birthday -->
      <div class="workshop-photo relative bg-white p-4 rounded-3xl shadow-md border-2 border-yellow/50 hover:rotate-0 -rotate-2 transition-all duration-300 group sm:col-span-2 lg:col-span-1">
        <!-- Washi tape -->
        <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 w-20 sm:w-24 h-5 sm:h-6 bg-yellow/90 -rotate-3 rounded-sm shadow-xs z-20"></div>
        <div class="h-52 sm:h-60 rounded-2xl overflow-hidden relative shadow-inner">
          <img 
            src="/images/workshop-5.jpg" 
            alt="Private Birthday Workshop" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-4 text-white">
            <span class="bg-yellow-dark self-start text-white text-[11px] font-heading font-bold px-3 py-0.5 rounded-full mb-1">
              Private Birthday
            </span>
            <h4 class="font-heading font-bold text-base">Creative Birthday Experience</h4>
          </div>
        </div>
        <div class="pt-4 pb-2 px-2">
          <h4 class="font-heading font-bold text-sm text-text-dark">Creative Birthday Experience</h4>
          <p class="text-xs text-text-muted mt-1 leading-relaxed">
            A fun and hands-on creative workshop designed to make birthday celebrations more colorful, personal, and memorable.
          </p>
        </div>
      </div>

    </div>

    <!-- Workshop CTA Banner -->
    <div class="mt-14 bg-white rounded-3xl p-8 border-2 border-pink/30 shadow-md flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <h3 class="font-heading text-xl font-bold text-text-dark">Interested in Hosting a Workshop at Your Event?</h3>
        <p class="text-xs sm:text-sm text-text-muted mt-1">We provide instructors, complete craft material kits, and engaging modules for schools, offices, or communities.</p>
      </div>
      <a 
        href="#contact" 
        class="shrink-0 bg-yellow hover:bg-yellow-dark text-text-dark font-heading font-bold text-sm px-6 py-3.5 rounded-full shadow-md hover:scale-105 active:scale-95 transition-all"
      >
        Request a Workshop Collaboration ✨
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initWorkshop = () => {
    gsap.fromTo(
      '.workshop-thumb',
      { opacity: 0, scale: 0.8 },
      {
        opacity: 1,
        scale: 1,
        stagger: 0.06,
        duration: 0.5,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.workshop-thumb',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '.workshop-photo',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.15,
        duration: 0.7,
        ease: 'back.out(1.4)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.workshop-photo',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.workshop-thumb, .workshop-photo').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorkshop);
  } else {
    initWorkshop();
  }
</script>
