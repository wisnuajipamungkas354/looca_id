---
// Testimonials.astro
---
<section id="testimonials" class="relative py-16 sm:py-20 lg:py-28 px-4 sm:px-8 bg-yellow-light/50 overflow-hidden">
  <!-- Subtle decorative flower -->
  <div class="absolute -left-8 sm:-left-10 bottom-6 sm:bottom-10 w-24 sm:w-40 opacity-15 sm:opacity-20 pointer-events-none animate-spin-slow">
    <img src="/decorations/flower-daisy.svg" alt="flower" class="w-full" />
  </div>

  <div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <div class="inline-block bg-yellow text-text-dark font-handwriting text-xl sm:text-2xl px-6 py-1.5 rounded-full shadow-sm mb-3">
        Cerita Mereka ✨
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark">
        Customer Testimonials
      </h2>
      <p class="text-text-muted mt-3 max-w-lg mx-auto text-sm sm:text-base">
        Honestly review after receiving looca.
      </p>
    </div>

    <!-- Cute Chat Bubble Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Bubble 1 -->
      <div class="testi-card bg-white p-5 sm:p-7 rounded-3xl border-2 border-pink/40 shadow-sm relative group hover:shadow-md transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-full bg-pink-light flex items-center justify-center border-2 border-pink text-pink-deep shadow-xs flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 sm:w-6 h-5 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-bold text-sm text-text-dark">Angel</h4>
            <span class="text-[11px] text-text-muted">Custom Bracelet Order</span>
          </div>
          <span class="ml-auto text-yellow-dark text-sm">★★★★★</span>
        </div>
        
        <!-- Chat Bubble Quote with Photo Attachment -->
        <div class="bg-pink-light/60 p-4 rounded-2xl rounded-tl-none border border-pink/20 text-text-dark text-sm font-sans leading-relaxed relative space-y-3">
          <!-- Photo Attachment like real WhatsApp unboxing -->
          <div class="w-full aspect-[3/4] rounded-2xl overflow-hidden shadow-xs bg-white">
            <img 
              src="/images/testimonials/testi1.jpeg" 
              alt="Angel Testimonial" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
          </div>
          <p>“sukaaaa banget nis, bagus bagus bangeettt 🫶🏻🥺 manaaa murahh lagiii! Bakal langganan terus fixx!”</p>
        </div>
        <div class="mt-3 text-right">
          <span class="text-[10px] text-text-muted">Verified Customer via WhatsApp</span>
        </div>
      </div>

      <!-- Bubble 2 -->
      <div class="testi-card bg-white p-5 sm:p-7 rounded-3xl border-2 border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-full bg-yellow-light flex items-center justify-center border-2 border-yellow text-yellow-dark shadow-xs flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 sm:w-6 h-5 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-bold text-sm text-text-dark">Cindy</h4>
            <span class="text-[11px] text-text-muted">Custom Bracelet Order</span>
          </div>
          <span class="ml-auto text-yellow-dark text-sm">★★★★★</span>
        </div>
        
        <div class="bg-yellow-light/60 p-4 rounded-2xl rounded-tl-none border border-yellow/30 text-text-dark text-sm font-sans leading-relaxed relative space-y-3">
          <!-- Photo Attachment -->
          <div class="w-full aspect-[3/4] rounded-2xl overflow-hidden shadow-xs bg-white">
            <img 
              src="/images/testimonials/testi2.jpeg" 
              alt="Cindy Testimonial" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
          </div>
          <p>“see!! ak pake jd keliatan mewah gaksieee... banyak tamu yg nanyain beli dmn! Packaging rapi, on time banget pengerjaannya!”</p>
        </div>
        <div class="mt-3 text-right">
          <span class="text-[10px] text-text-muted">Verified Client via Instagram</span>
        </div>
      </div>

      <!-- Bubble 3 -->
      <div class="testi-card bg-white p-5 sm:p-7 rounded-3xl border-2 border-blue-soft/50 shadow-sm relative group hover:shadow-md transition-all">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-11 sm:w-12 h-11 sm:h-12 rounded-full bg-blue-soft/20 flex items-center justify-center border-2 border-blue-soft text-blue-500 shadow-xs flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 sm:w-6 h-5 sm:h-6" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h4 class="font-heading font-bold text-sm text-text-dark">D****</h4>
            <span class="text-[11px] text-text-muted">Phone Strap & Bagcharms</span>
          </div>
          <span class="ml-auto text-yellow-dark text-sm">★★★★★</span>
        </div>
        
        <div class="bg-blue-soft/20 p-4 rounded-2xl rounded-tl-none border border-blue-soft/30 text-text-dark text-sm font-sans leading-relaxed relative space-y-3">
          <!-- Photo Attachment -->
          <div class="w-full aspect-[3/4] rounded-2xl overflow-hidden shadow-xs bg-white">
            <img 
              src="/images/testimonials/testi3.jpeg" 
              alt="D**** Testimonial" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
          </div>
          <p>“Unik banget ga pasaran! Bener-bener handmade yang rapi, warnanya estetik dan lucu banget buat kado temen 💖”</p>
        </div>
        <div class="mt-3 text-right">
          <span class="text-[10px] text-text-muted">Verified Review via Shopee</span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initTestimonials = () => {
    gsap.fromTo(
      '.testi-card',
      { opacity: 0, scale: 0.85, y: 30 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        stagger: 0.15,
        duration: 0.7,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#testimonials',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.testi-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonials);
  } else {
    initTestimonials();
  }
</script>
