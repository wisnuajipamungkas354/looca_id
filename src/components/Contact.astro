---
// Contact.astro (Thank you & Keep in touch)
---
<section id="contact" class="relative overflow-hidden">
  
  <!-- Part 1: Thank You & Slogan Banner (From Screenshot 3) -->
  <div class="py-20 sm:py-24 px-4 sm:px-8 bg-gradient-to-b from-yellow-light/60 via-peach/40 to-blue-soft/30 text-center relative">
    <div class="max-w-3xl mx-auto">
      <h2 class="thank-you-text font-handwriting text-5xl sm:text-7xl font-bold text-yellow-dark mb-4 drop-shadow-sm">
        Thank you 💖
      </h2>
      <p class="font-sans text-base sm:text-xl text-text-dark max-w-xl mx-auto leading-relaxed mb-6">
        Looca believes that every creation holds its own story, character, and meaning.
      </p>
      <div class="inline-block bg-white/90 backdrop-blur-sm border-2 border-yellow/60 px-8 py-3 rounded-full shadow-md">
        <span class="font-heading font-extrabold text-xl sm:text-2xl text-text-dark">
          Take a Looca, Take Your Loove.
        </span>
      </div>
    </div>
  </div>

  <!-- Part 2: Keep In Touch Channels (From Screenshot 3) -->
  <div class="py-20 px-4 sm:px-8 bg-[#A8D8EA]/25 relative">
    <!-- Big cute rotating daisy in the bottom right corner (like original) -->
    <div class="absolute -right-6 -bottom-6 w-36 sm:w-48 pointer-events-none opacity-80 animate-spin-slow">
      <img src="/decorations/flower-daisy.svg" alt="daisy" class="w-full drop-shadow-lg" />
    </div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <div class="inline-block bg-white/90 text-yellow-dark font-handwriting text-2xl sm:text-4xl px-8 py-2 rounded-full shadow-md -rotate-1 mb-10 border border-yellow">
        Keep in touch ✨
      </div>

      <!-- Social / Order Channel Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        
        <!-- Shopee -->
        <a 
          href="https://shopee.co.id/looca_id" 
          target="_blank" 
          rel="noopener noreferrer"
          class="contact-channel bg-white hover:bg-orange-50/70 p-4 rounded-3xl border-2 border-orange-200 shadow-sm hover:shadow-md flex items-center gap-4 transition-all group"
        >
          <img 
            src="/images/icon-shopee.svg" 
            alt="Shopee" 
            class="w-12 h-12 rounded-2xl shadow-sm group-hover:scale-110 transition-transform shrink-0" 
          />
          <div class="text-left">
            <span class="text-[11px] font-heading font-semibold text-text-muted block">Official Store</span>
            <span class="font-heading font-bold text-base text-text-dark group-hover:text-orange-600 transition-colors">
              shopee.co.id/looca_id
            </span>
          </div>
        </a>

        <!-- Instagram -->
        <a 
          href="https://instagram.com/_looca_id" 
          target="_blank" 
          rel="noopener noreferrer"
          class="contact-channel bg-white hover:bg-pink-light/70 p-4 rounded-3xl border-2 border-pink/40 shadow-sm hover:shadow-md flex items-center gap-4 transition-all group"
        >
          <img 
            src="/images/icon-instagram.svg" 
            alt="Instagram" 
            class="w-12 h-12 rounded-2xl shadow-sm group-hover:scale-110 transition-transform shrink-0" 
          />
          <div class="text-left">
            <span class="text-[11px] font-heading font-semibold text-text-muted block">Instagram Profile</span>
            <span class="font-heading font-bold text-base text-text-dark group-hover:text-pink-deep transition-colors">
              _looca_id
            </span>
          </div>
        </a>

        <!-- WhatsApp -->
        <a 
          href="https://wa.me/6281215312939" 
          target="_blank" 
          rel="noopener noreferrer"
          class="contact-channel bg-white hover:bg-green-50/70 p-4 rounded-3xl border-2 border-green-200 shadow-sm hover:shadow-md flex items-center gap-4 transition-all group"
        >
          <img 
            src="/images/icon-whatsapp.svg" 
            alt="WhatsApp" 
            class="w-12 h-12 rounded-2xl shadow-sm group-hover:scale-110 transition-transform shrink-0" 
          />
          <div class="text-left">
            <span class="text-[11px] font-heading font-semibold text-text-muted block">WhatsApp Order / CS</span>
            <span class="font-heading font-bold text-base text-text-dark group-hover:text-green-600 transition-colors">
              0812-1531-2939
            </span>
          </div>
        </a>

        <!-- TikTok -->
        <a 
          href="https://tiktok.com/@looca_id" 
          target="_blank" 
          rel="noopener noreferrer"
          class="contact-channel bg-white hover:bg-gray-100 p-4 rounded-3xl border-2 border-gray-200 shadow-sm hover:shadow-md flex items-center gap-4 transition-all group"
        >
          <img 
            src="/images/icon-tiktok.svg" 
            alt="TikTok" 
            class="w-12 h-12 rounded-2xl shadow-sm group-hover:scale-110 transition-transform shrink-0" 
          />
          <div class="text-left">
            <span class="text-[11px] font-heading font-semibold text-text-muted block">TikTok Content</span>
            <span class="font-heading font-bold text-base text-text-dark group-hover:text-black transition-colors">
              Looca_id
            </span>
          </div>
        </a>

      </div>
    </div>
  </div>

  <!-- Cute Footer -->
  <footer class="bg-white py-8 px-4 text-center border-t border-pink/30">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted font-heading">
      <div class="flex items-center gap-2.5">
        <img src="/logo.png" alt="Looca Logo" class="w-7 h-7 rounded-full object-cover border border-pink/50" />
        <span class="font-handwriting text-xl font-bold text-pink-deep">looca_id</span>
        <span class="hidden sm:inline text-text-muted">• Take a Looca, Take Your Loove.</span>
      </div>
      <div>
        <p>&copy; {new Date().getFullYear()} Looca ID. Crafted with love & joy 🌸</p>
      </div>
    </div>
  </footer>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initContact = () => {
    // Thank you text bounce
    gsap.fromTo(
      '.thank-you-text',
      { opacity: 0, scale: 0.7 },
      {
        opacity: 1,
        scale: 1,
        duration: 0.8,
        ease: 'elastic.out(1, 0.6)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Contact channels reveal (Shopee, IG, WA, TikTok)
    gsap.fromTo(
      '.contact-channel',
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.5,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 95%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe: Guarantees Shopee, IG, WA, and TikTok are ALWAYS 100% visible
    setTimeout(() => {
      document.querySelectorAll('.contact-channel, .thank-you-text').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 800);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContact);
  } else {
    initContact();
  }
</script>
