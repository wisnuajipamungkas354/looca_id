---
// Home.astro
---
<section id="home" class="relative min-h-screen pt-28 sm:pt-32 lg:pt-24 pb-16 sm:pb-20 lg:pb-16 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center overflow-hidden bg-gradient-to-b from-[#FCE8ED] via-[#FFF3E8] to-[#FFFDF9]">
  <!-- Subtle craft background texture like the original store photo -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.08] mix-blend-multiply">
    <img 
      src="/images/hero-craft-table.jpg" 
      alt="Craft Table Background" 
      class="w-full h-full object-cover" 
    />
  </div>

  <!-- Top Scallop Border (like original) -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 opacity-90">
    <img src="/decorations/wave-yellow.svg" alt="wave decoration" class="w-full h-8 sm:h-10 object-cover object-top" />
  </div>

  <!-- Floating Cute Decorative Stickers (Background Doodles) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-10">
    <!-- Star Doodle Left -->
    <div class="hero-sticker absolute top-28 sm:top-36 left-3 sm:left-14 w-12 sm:w-20 md:w-24 -rotate-12 animate-float opacity-90 sm:opacity-100">
      <img src="/decorations/star.png" alt="star" class="w-full drop-shadow-md" />
    </div>

    <!-- Heart Doodle Right (Clearly visible on mobile & desktop) -->
    <div class="hero-sticker absolute top-28 sm:top-36 right-3 sm:right-16 w-12 sm:w-20 md:w-24 rotate-12 animate-float opacity-90 sm:opacity-100" style="animation-delay: 1s;">
      <img src="/decorations/heart.png" alt="heart" class="w-full drop-shadow-md" />
    </div>

    <!-- Daisy Flower Bottom Left -->
    <div class="hero-sticker absolute bottom-20 sm:bottom-28 left-4 sm:left-24 w-11 sm:w-18 md:w-24 animate-spin-slow opacity-85 sm:opacity-100">
      <img src="/decorations/flower-daisy.svg" alt="daisy" class="w-full drop-shadow" />
    </div>

    <!-- Cherry Doodle Bottom Right -->
    <div class="hero-sticker absolute bottom-20 sm:bottom-28 right-4 sm:right-28 w-11 sm:w-18 md:w-24 rotate-6 animate-float opacity-85 sm:opacity-100" style="animation-delay: 1.5s;">
      <img src="/decorations/cherry.svg" alt="cherry" class="w-full drop-shadow" />
    </div>
  </div>

  <!-- Main Hero Content (Centered 1-Column Layout - Compact & Fits in 1 Viewport) -->
  <div class="relative z-20 max-w-2xl lg:max-w-3xl mx-auto text-center flex flex-col items-center my-auto">
    <!-- Welcome Speech Bubble -->
    <div class="hero-bubble inline-flex items-center gap-2 bg-[#89CFF0] text-white font-handwriting text-sm sm:text-base lg:text-lg px-5 sm:px-6 py-1.5 sm:py-2 rounded-full shadow-md border-2 border-white -rotate-2 mb-2 sm:mb-3">
      <span>Hi! Welcome to our home!</span>
      <span class="text-base sm:text-lg">✨</span>
    </div>

    <!-- Central Looca Studio Flower Emblem -->
    <div class="hero-flower relative my-1.5 sm:my-2.5 w-[75vw] max-w-[280px] sm:max-w-[330px] md:max-w-[370px] lg:max-w-[400px] xl:max-w-[420px] transition-transform duration-500 hover:scale-105 cursor-pointer flex items-center justify-center group">
      <img 
        src="/decorations/hero-logo.png" 
        alt="Looca Studio Flower" 
        class="w-full drop-shadow-xl filter" 
      />
    </div>

    <!-- Tagline & Description -->
    <div class="hero-text mt-2 sm:mt-3 max-w-lg">
      <h1 class="font-heading text-2xl sm:text-3xl lg:text-3xl xl:text-4xl font-extrabold text-text-dark tracking-tight leading-tight">
        Take a looca, Take your loove
      </h1>
      <p class="font-sans text-xs sm:text-sm lg:text-base text-text-muted mt-1.5 sm:mt-2 leading-relaxed">
        Affordable • More durable accessories <br /> Adjustable budget and quantity • Free service accessories.
      </p>
    </div>

    <!-- CTA Buttons -->
    <div class="hero-cta mt-4 sm:mt-5 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a 
        href="#products" 
        class="bg-pink-deep hover:bg-pink-deep/90 text-white font-heading font-bold text-sm sm:text-base px-6 sm:px-7 py-2.5 sm:py-3 rounded-full shadow-md shadow-pink-deep/25 hover:scale-105 active:scale-95 transition-all flex items-center gap-2"
      >
        <span>Explore Products</span>
        <span>🌸</span>
      </a>
      <a 
        href="#about" 
        class="bg-white/90 hover:bg-white text-text-dark font-heading font-semibold text-sm sm:text-base px-5 sm:px-6 py-2.5 sm:py-3 rounded-full shadow-sm border border-pink/40 hover:scale-105 active:scale-95 transition-all"
      >
        About Looca
      </a>
    </div>
  </div>

  <!-- Bottom Wave Transition to About Section -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10">
    <img src="/decorations/wave-pink.svg" alt="pink wave divider" class="w-full h-10 sm:h-14 object-cover object-bottom" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const initHero = () => {
    // Safe entrance animation with clearProps
    const tl = gsap.timeline();

    tl.fromTo(
      '.hero-bubble',
      { scale: 0.85, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(1.5)', clearProps: 'all' }
    )
    .fromTo(
      '.hero-flower',
      { scale: 0.9, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.6, ease: 'back.out(1.2)', clearProps: 'all' },
      '-=0.3'
    )
    .fromTo(
      ['.hero-text', '.hero-cta'],
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out', clearProps: 'all' },
      '-=0.2'
    )
    .fromTo(
      '.hero-sticker',
      { scale: 0.7, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.4, stagger: 0.08, ease: 'back.out(1.5)', clearProps: 'all' },
      '-=0.3'
    );

    // Guaranteed failsafe: within 600ms, ensure EVERYTHING is 100% visible and at full natural size
    setTimeout(() => {
      document.querySelectorAll('.hero-bubble, .hero-flower, .hero-text, .hero-cta, .hero-sticker').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 600);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
