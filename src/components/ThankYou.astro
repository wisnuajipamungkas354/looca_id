---
// ThankYou.astro
---
<section id="thank-you" class="py-16 sm:py-24 px-4 sm:px-8 bg-gradient-to-b from-yellow-light/60 via-peach/40 to-cream text-center relative overflow-hidden">
  <div class="max-w-3xl mx-auto">
    <h2 class="thank-you-text font-handwriting text-4xl sm:text-6xl md:text-7xl font-bold text-yellow-dark mb-4 drop-shadow-sm">
      Thank you 💖
    </h2>
    <p class="font-sans text-sm sm:text-xl text-text-dark max-w-xl mx-auto leading-relaxed mb-6">
      Looca believes that every creation holds its own story, character, and meaning.
    </p>
    <div class="inline-block bg-white/90 backdrop-blur-sm border-2 border-yellow/60 px-5 sm:px-8 py-2.5 sm:py-3 rounded-full shadow-md hover:scale-105 transition-transform">
      <span class="font-heading font-extrabold text-base sm:text-2xl text-text-dark">
        Take a Looca, Take Your Loove.
      </span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initThankYou = () => {
    gsap.fromTo(
      '.thank-you-text',
      { opacity: 0, scale: 0.7 },
      {
        opacity: 1,
        scale: 1,
        duration: 0.8,
        ease: 'elastic.out(1, 0.6)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#thank-you',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.thank-you-text').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 800);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThankYou);
  } else {
    initThankYou();
  }
</script>
