---
// Journey.astro (Mission & Why Looca)
---
<section id="journey" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <!-- Top Header -->
    <div class="text-center mb-16">
      <div class="inline-block bg-yellow-light text-yellow-dark border border-yellow font-handwriting text-lg sm:text-xl px-5 py-1 rounded-full shadow-sm mb-3">
        meaning of our 4 petals 🌸
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark tracking-tight">
        OUR MISSION
      </h2>
      <p class="text-text-muted mt-3 max-w-lg mx-auto text-sm sm:text-base">
        Setiap kelopak bunga Looca melambangkan nilai dan dedikasi kami untuk menghadirkan kebaikan.
      </p>
    </div>

    <!-- 4 Petals Blossom Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto mb-20">
      
      <!-- Petal 01 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-pink/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-sm">
          01
        </div>
        <div class="w-14 h-14 rounded-2xl bg-pink/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🎁
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Quality Products</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Premium Materials • Transparent Process • Consistent Quality untuk setiap karya yang kami hasilkan.
        </p>
      </div>

      <!-- Petal 02 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-yellow/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-yellow-light flex items-center justify-center font-heading font-bold text-yellow-dark text-sm">
          02
        </div>
        <div class="w-14 h-14 rounded-2xl bg-yellow/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🎨
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Creative Experiences & Connection</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Bukan sekadar bagaimana cara membuatnya, namun juga apa makna dan cerita berharga di baliknya.
        </p>
      </div>

      <!-- Petal 03 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-blue-soft/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-blue-soft/20 flex items-center justify-center font-heading font-bold text-blue-500 text-sm">
          03
        </div>
        <div class="w-14 h-14 rounded-2xl bg-blue-soft/40 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🤝
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Empower Local Makers</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Direct Collaboration & Sustainable Growth bersama pengrajin dan komunitas lokal kreatif.
        </p>
      </div>

      <!-- Petal 04 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-pink-dark/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-sm">
          04
        </div>
        <div class="w-14 h-14 rounded-2xl bg-pink-deep/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🌱
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Give Back to Society</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Community Workshops & Reusable Packaging untuk lingkungan yang lebih lestari dan berdaya.
        </p>
      </div>

    </div>

    <!-- "Why Looca?" Card -->
    <div class="why-looca-card max-w-4xl mx-auto bg-gradient-to-r from-yellow-light via-white to-pink-light p-8 sm:p-10 rounded-3xl border border-yellow/50 shadow-md">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5">
          <span class="font-handwriting text-2xl text-yellow-dark block mb-1">Kenapa memilih kami?</span>
          <h3 class="font-heading text-3xl font-extrabold text-text-dark">Why Looca?</h3>
          <p class="text-sm text-text-muted mt-2">
            Dedikasi kami untuk memberikan pengalaman terbaik dalam setiap pesanan custom Anda.
          </p>
        </div>
        
        <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="why-item flex items-start gap-3 bg-white/80 p-4 rounded-2xl shadow-sm border border-yellow/20">
            <span class="text-xl">💰</span>
            <div>
              <h4 class="font-heading font-bold text-sm text-text-dark">Affordable & Custom</h4>
              <p class="text-xs text-text-muted">Bebas request desain sesuai selera.</p>
            </div>
          </div>

          <div class="why-item flex items-start gap-3 bg-white/80 p-4 rounded-2xl shadow-sm border border-pink/20">
            <span class="text-xl">✨</span>
            <div>
              <h4 class="font-heading font-bold text-sm text-text-dark">Stainless & Durable</h4>
              <p class="text-xs text-text-muted">Material awet dan tahan lama.</p>
            </div>
          </div>

          <div class="why-item flex items-start gap-3 bg-white/80 p-4 rounded-2xl shadow-sm border border-yellow/20">
            <span class="text-xl">🎉</span>
            <div>
              <h4 class="font-heading font-bold text-sm text-text-dark">Fun Experience</h4>
              <p class="text-xs text-text-muted">Proses kreasi yang seru dan berkesan.</p>
            </div>
          </div>

          <div class="why-item flex items-start gap-3 bg-white/80 p-4 rounded-2xl shadow-sm border border-pink/20">
            <span class="text-xl">📦</span>
            <div>
              <h4 class="font-heading font-bold text-sm text-text-dark">Adjustable Qty</h4>
              <p class="text-xs text-text-muted">Jumlah dan budget fleksibel.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initJourney = () => {
    gsap.fromTo(
      '.petal-card',
      { opacity: 0, scale: 0.85, y: 30 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#journey',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '.why-looca-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.why-looca-card',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.petal-card, .why-looca-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourney);
  } else {
    initJourney();
  }
</script>
