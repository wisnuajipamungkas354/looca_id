---
// Journey.astro (Mission & Why Looca)
---
<section id="journey" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
    <!-- Top Header -->
    <div class="text-center max-w-6xl mx-auto">
      <div class="inline-block bg-yellow-light text-yellow-dark border border-yellow font-handwriting text-lg sm:text-xl px-5 py-1 rounded-full shadow-sm mb-3">
        meaning of our 4 petals 🌸
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark tracking-tight">
        OUR MISSION
      </h2>
      <p class="text-text-muted my-3 max-w-lg mx-auto text-sm sm:text-base">
        Each petal represents a value we stand for.
      </p>
    </div>

    <!-- 4 Petals Blossom Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
      
      <!-- Petal 01 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-pink/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-sm">
          01
        </div>
        <div class="w-14 h-14 rounded-2xl bg-pink/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🎁
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Quality Products</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          <strong class="text-[13px] sm:text-sm block mb-1">
            <span class="whitespace-nowrap">Premium Materials</span> &bull; 
            <span class="whitespace-nowrap">Transparent Process</span> &bull; 
            <span class="whitespace-nowrap">Consistent Quality</span>
          </strong>
          Quality you can trust, every step of the way.
        </p>
      </div>

      <!-- Petal 02 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-yellow/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-yellow-light flex items-center justify-center font-heading font-bold text-yellow-dark text-sm">
          02
        </div>
        <div class="w-14 h-14 rounded-2xl bg-yellow/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🎨
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Creative Experiences & Connection</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          More than just how it’s made, we also create meaningful experiences and stories behind it.
        </p>
      </div>

      <!-- Petal 03 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-blue-soft/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-blue-soft/20 flex items-center justify-center font-heading font-bold text-blue-500 text-sm">
          03
        </div>
        <div class="w-14 h-14 rounded-2xl bg-blue-soft/40 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🤝
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Empower Local Makers</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          <strong class="text-[13px] sm:text-sm block mb-1">
            <span class="whitespace-nowrap">Direct Collaboration</span> &amp; 
            <span class="whitespace-nowrap">Sustainable Growth</span>
          </strong>
          Collaborating with and empowering local artisans and communities.
        </p>
      </div>

      <!-- Petal 04 -->
      <div class="petal-card bg-white p-7 rounded-3xl border-2 border-pink-dark/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-sm">
          04
        </div>
        <div class="w-14 h-14 rounded-2xl bg-pink-deep/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
          🌱
        </div>
        <h3 class="font-heading text-xl font-bold text-text-dark mb-2">Give Back to Society</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          <strong class="text-[13px] sm:text-sm block mb-1">
            <span class="whitespace-nowrap">Community Workshops</span> &amp; 
            <span class="whitespace-nowrap">Reusable Packaging</span>
          </strong>
          Creating a positive impact and a more sustainable future.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initJourney = () => {
    gsap.fromTo(
      '.petal-card',
      { opacity: 0, scale: 0.85, y: 30 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#journey',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.petal-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourney);
  } else {
    initJourney();
  }
</script>
