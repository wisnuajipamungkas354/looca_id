---
// Journey.astro (Mission & Why Looca)
---
<section id="journey" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-cream overflow-hidden">
    <!-- Top Header -->
    <div class="text-center max-w-6xl mx-auto">
      <div class="inline-flex items-center gap-1.5 bg-yellow-light text-yellow-dark border border-yellow font-handwriting text-lg sm:text-xl px-5 py-1 rounded-full shadow-sm mb-3">
        <span>meaning of our 4 petals</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-yellow-dark" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/></svg>
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-text-dark tracking-tight">
        OUR MISSION
      </h2>
      <p class="text-text-muted my-3 max-w-lg mx-auto text-sm sm:text-base">
        Each petal represents a value we stand for.
      </p>
    </div>

    <!-- 4 Petals Blossom Grid (2 Columns on Mobile, 2 on Desktop) -->
    <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:gap-8 max-w-4xl mx-auto">
      
      <!-- Petal 01 -->
      <div class="petal-card bg-white p-3.5 sm:p-7 rounded-2xl sm:rounded-3xl border-2 border-pink/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group flex flex-col">
        <div class="absolute top-2.5 right-2.5 sm:top-4 sm:right-4 w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-xs sm:text-sm">
          01
        </div>
        <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-pink/30 flex items-center justify-center text-pink-deep mb-2.5 sm:mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 12 20 22 4 22 4 12"></polyline>
            <rect x="2" y="7" width="20" height="5"></rect>
            <line x1="12" y1="22" x2="12" y2="7"></line>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
          </svg>
        </div>
        <h3 class="font-heading text-xs sm:text-xl font-bold text-text-dark mb-1 sm:mb-2 leading-snug">Quality Products</h3>
        <p class="text-text-muted text-[11px] sm:text-sm leading-relaxed">
          <strong class="text-[10px] sm:text-sm block mb-1">
            Premium Materials &bull; Transparent Process &bull; Consistent Quality
          </strong>
          Quality you can trust, every step of the way.
        </p>
      </div>

      <!-- Petal 02 -->
      <div class="petal-card bg-white p-3.5 sm:p-7 rounded-2xl sm:rounded-3xl border-2 border-yellow/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group flex flex-col">
        <div class="absolute top-2.5 right-2.5 sm:top-4 sm:right-4 w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-yellow-light flex items-center justify-center font-heading font-bold text-yellow-dark text-xs sm:text-sm">
          02
        </div>
        <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-yellow/30 flex items-center justify-center text-yellow-dark mb-2.5 sm:mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
            <path d="M2 2l7.586 7.586"></path>
            <circle cx="11" cy="11" r="2"></circle>
          </svg>
        </div>
        <h3 class="font-heading text-xs sm:text-xl font-bold text-text-dark mb-1 sm:mb-2 leading-snug">Creative Experiences & Connection</h3>
        <p class="text-text-muted text-[11px] sm:text-sm leading-relaxed">
          More than just how it’s made, we also create meaningful experiences and stories behind it.
        </p>
      </div>

      <!-- Petal 03 -->
      <div class="petal-card bg-white p-3.5 sm:p-7 rounded-2xl sm:rounded-3xl border-2 border-blue-soft/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group flex flex-col">
        <div class="absolute top-2.5 right-2.5 sm:top-4 sm:right-4 w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-blue-soft/20 flex items-center justify-center font-heading font-bold text-blue-500 text-xs sm:text-sm">
          03
        </div>
        <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-soft/40 flex items-center justify-center text-blue-600 mb-2.5 sm:mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="font-heading text-xs sm:text-xl font-bold text-text-dark mb-1 sm:mb-2 leading-snug">Empower Local Makers</h3>
        <p class="text-text-muted text-[11px] sm:text-sm leading-relaxed">
          <strong class="text-[10px] sm:text-sm block mb-1">
            Direct Collaboration &bull; Sustainable Growth
          </strong>
          Collaborating with and empowering local artisans and communities.
        </p>
      </div>

      <!-- Petal 04 -->
      <div class="petal-card bg-white p-3.5 sm:p-7 rounded-2xl sm:rounded-3xl border-2 border-pink-dark/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative overflow-hidden group flex flex-col">
        <div class="absolute top-2.5 right-2.5 sm:top-4 sm:right-4 w-7 h-7 sm:w-10 sm:h-10 rounded-full bg-pink-light flex items-center justify-center font-heading font-bold text-pink-deep text-xs sm:text-sm">
          04
        </div>
        <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-pink-deep/20 flex items-center justify-center text-pink-deep mb-2.5 sm:mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22v-9"></path>
            <path d="M12 13a5 5 0 0 0-5-5H3a9 9 0 0 1 9-9 9 9 0 0 1 9 9h-4a5 5 0 0 0-5 5z"></path>
          </svg>
        </div>
        <h3 class="font-heading text-xs sm:text-xl font-bold text-text-dark mb-1 sm:mb-2 leading-snug">Give Back to Society</h3>
        <p class="text-text-muted text-[11px] sm:text-sm leading-relaxed">
          <strong class="text-[10px] sm:text-sm block mb-1">
            Community Workshops &bull; Reusable Packaging
          </strong>
          Creating a positive impact and a more sustainable future.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initJourney = () => {
    gsap.fromTo(
      '.petal-card',
      { opacity: 0, scale: 0.85, y: 30 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'back.out(1.5)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#journey',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.petal-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJourney);
  } else {
    initJourney();
  }
</script>
