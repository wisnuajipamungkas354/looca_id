---
// UpcomingEvents.astro
// Cute Upcoming Events component fetching active events from Looca Go backend API
// Includes cute Scrapbook Ticket Cards and a Cute Pastel Schedule Table toggle

export interface EventItem {
  id: number;
  title: string;
  sub_title?: string;
  description?: string;
  poster?: string;
  start_date?: string;
  start_time?: string;
  place?: string;
  admission_fee?: number | null;
  origin_link?: string;
  short_link?: string;
  is_coming_soon: boolean;
  is_active: boolean;
}

const publicApiUrl = (import.meta.env.PUBLIC_API_URL || 'https://backend.looca-id.com').replace(/\/$/, '');
const internalApiUrl = import.meta.env.INTERNAL_API_URL;
const fetchApiUrl = (internalApiUrl && internalApiUrl.trim() !== '') ? internalApiUrl.trim().replace(/\/$/, '') : publicApiUrl;
const apiUrl = publicApiUrl;

let initialEvents: EventItem[] = [];

try {
  const res = await fetch(`${fetchApiUrl}/api/public/events`, {
    headers: {
      'Accept': 'application/json',
    },
    signal: AbortSignal.timeout(3000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      initialEvents = data;
    }
  }
} catch (error) {
  console.warn('[UpcomingEvents] Build-time fetch notice:', error);
}

const formatDate = (dateStr?: string) => {
  if (!dateStr) return 'TBA';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-US', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
};

const formatPrice = (price?: number | null) => {
  if (!price || price <= 0) return 'Free / TBA';
  return `IDR ${Number(price).toLocaleString('en-US')}`;
};

const getPosterUrl = (posterPath?: string) => {
  if (!posterPath) return '/images/workshop/moru-doll.jpeg';
  if (posterPath.startsWith('http')) return posterPath;
  return `${apiUrl}${posterPath.startsWith('/') ? posterPath : '/' + posterPath}`;
};

const resolveEventLink = (shortLink?: string | null, originLink?: string | null) => {
  if (shortLink && shortLink.trim() !== '') {
    let s = shortLink.trim();
    if (s.includes('looca.id')) {
      s = s.replace(/https?:\/\/(?:www\.)?looca\.id/i, 'https://looca-id.com');
    } else if (s.startsWith('/event/') || s.startsWith('/r/')) {
      s = `https://looca-id.com${s}`;
    } else if (!s.startsWith('http://') && !s.startsWith('https://')) {
      s = `https://looca-id.com/event/${s}`;
    }
    return s;
  }
  if (originLink && originLink.trim() !== '') {
    let d = originLink.trim();
    if (!d.startsWith('http://') && !d.startsWith('https://')) {
      d = 'https://' + d;
    }
    return d;
  }
  return 'https://instagram.com/looca_id';
};
---

<div id="upcoming-events-container" class="relative mb-16 sm:mb-20" data-api-url={apiUrl} data-initial-events={JSON.stringify(initialEvents)}>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
    <div class="text-center sm:text-left">
      <div class="inline-flex items-center gap-1.5 text-xs font-heading font-semibold text-pink-deep bg-pink/20 px-3 py-1 rounded-full border border-pink/40 mb-1.5">
        <span>Upcoming Schedule</span>
      </div>
      <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-text-dark flex items-center justify-center sm:justify-start gap-2">
        <span>Upcoming Events & Classes</span>
      </h3>
      <p class="text-xs sm:text-sm text-text-muted mt-1 max-w-lg">
        Join our interactive creative workshops and craft gatherings. Limited slots available for each class.
      </p>
    </div>

    <!-- View Switcher: Cards vs Table -->
    <div class="inline-flex items-center p-1 bg-white border-2 border-pink/30 rounded-2xl shadow-xs shrink-0">
      <button
        id="btn-view-cards"
        type="button"
        class="px-3.5 py-1.5 rounded-xl font-heading font-bold text-xs transition-all flex items-center gap-1.5 bg-pink-deep text-white shadow-xs cursor-pointer"
        aria-label="View as Cards"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Card View</span>
      </button>
      <button
        id="btn-view-table"
        type="button"
        class="px-3.5 py-1.5 rounded-xl font-heading font-bold text-xs transition-all flex items-center gap-1.5 text-text-muted hover:text-pink-deep cursor-pointer"
        aria-label="View as Table"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>Schedule Table</span>
      </button>
    </div>
  </div>

  <!-- VIEW 1: SCRAPBOOK TICKET CARDS -->
  <div id="events-cards-view" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
    {initialEvents.length === 0 ? (
      <div class="col-span-full py-12 px-6 bg-white/80 rounded-3xl border-2 border-dashed border-pink/40 text-center flex flex-col items-center justify-center">
        <div class="w-14 h-14 rounded-full bg-pink-light flex items-center justify-center mb-3 text-pink-deep">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <h4 class="font-heading font-bold text-lg text-text-dark mb-1">No Upcoming Events Right Now</h4>
        <p class="text-xs sm:text-sm text-text-muted max-w-md">All upcoming workshops have concluded or are being scheduled. Check back soon or follow us on Instagram for next schedule announcements!</p>
        <a href="https://instagram.com/looca_id" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-xs py-2 px-4 rounded-xl shadow-xs transition-all hover:scale-105">
          <span>Follow @looca_id on Instagram</span>
        </a>
      </div>
    ) : (
      initialEvents.map((evt, idx) => {
        const isEven = idx % 2 === 0;
        const washiColor = isEven ? 'bg-yellow/90' : 'bg-pink/90';
        const washiRotate = isEven ? '-rotate-2' : 'rotate-2';
        const cardRotate = idx % 3 === 0 ? '-rotate-1 hover:rotate-0' : idx % 3 === 1 ? 'rotate-1 hover:rotate-0' : 'hover:-rotate-1';
        const eventLink = resolveEventLink(evt.short_link, evt.origin_link);

        return (
          <div
            class={`event-card relative bg-white rounded-3xl p-5 border-2 border-pink/30 shadow-md ${cardRotate} transition-all duration-300 flex flex-col justify-between group hover:shadow-xl hover:border-pink-deep/50 cursor-pointer`}
            data-event-id={evt.id}
          >
            <!-- Washi tape header deco -->
            <div class={`absolute -top-3 left-1/2 -translate-x-1/2 w-24 h-6 ${washiColor} ${washiRotate} rounded-sm shadow-xs z-20 flex items-center justify-center pointer-events-none`}>
              <span class="text-[9px] font-heading font-bold text-text-dark opacity-75">Workshop</span>
            </div>

            <div>
              <!-- Poster Frame with Polaroid feel (Portrait aspect ratio) -->
              <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden bg-pink-light/50 border border-pink/30 mb-4 shadow-inner">
                <img
                  src={getPosterUrl(evt.poster)}
                  alt={evt.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/images/workshop/flower-bagcharms.jpeg';"
                />

                <!-- Status Badge Pill -->
                <div class="absolute top-2.5 left-2.5 z-10">
                  {evt.is_coming_soon ? (
                    <span class="bg-yellow text-text-dark font-heading font-bold text-[11px] px-2.5 py-0.5 rounded-full shadow-xs border border-yellow-dark/30">
                      Coming Soon
                    </span>
                  ) : (
                    <span class="bg-pink-deep text-white font-heading font-bold text-[11px] px-2.5 py-0.5 rounded-full shadow-xs border border-white/30">
                      Open Registration
                    </span>
                  )}
                </div>
              </div>

              <!-- Date & Time Row -->
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="inline-flex items-center gap-1.5 text-xs font-heading font-extrabold text-pink-deep bg-pink-light px-2.5 py-1 rounded-xl border border-pink/30">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-pink-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{formatDate(evt.start_date)}</span>
                </div>

                {evt.start_time && (
                  <div class="inline-flex items-center gap-1 text-[11px] font-heading font-semibold text-text-muted bg-cream px-2 py-0.5 rounded-lg border border-pink/20 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>{evt.start_time}</span>
                  </div>
                )}
              </div>

              <!-- Title -->
              <h4 class="font-heading font-bold text-base sm:text-lg text-text-dark leading-snug mb-1 group-hover:text-pink-deep transition-colors line-clamp-1" title={evt.title}>
                {evt.title}
              </h4>

              <!-- Sub Title below Title -->
              {evt.sub_title && (
                <p class="text-xs font-heading font-semibold text-pink-deep mb-2 line-clamp-1">
                  {evt.sub_title}
                </p>
              )}

              <!-- Description -->
              {evt.description && (
                <p class="text-xs text-text-muted leading-relaxed line-clamp-2 mb-3">
                  {evt.description}
                </p>
              )}

              <!-- Venue / Place -->
              {evt.place && (
                <div class="flex items-start gap-1.5 text-[11px] text-text-muted mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-pink-deep shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span class="line-clamp-1">{evt.place}</span>
                </div>
              )}
            </div>

            <!-- Bottom Ticket Area with Perforated dashed border -->
            <div class="pt-3 border-t-2 border-dashed border-pink/30 mt-auto flex items-center justify-between gap-3">
              <div>
                <span class="text-[10px] uppercase font-heading font-bold text-text-muted block">Admission</span>
                <span class="font-heading font-extrabold text-sm text-pink-deep">
                  {formatPrice(evt.admission_fee)}
                </span>
              </div>

              <a
                href={eventLink}
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                class="inline-flex items-center gap-1.5 bg-yellow hover:bg-yellow-dark text-text-dark font-heading font-bold text-xs py-2 px-3.5 rounded-xl shadow-xs hover:scale-105 active:scale-95 transition-all"
              >
                <span>{evt.is_coming_soon ? 'Details' : 'Register'}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- VIEW 2: SCHEDULE TABLE -->
  <div id="events-table-view" class="hidden overflow-hidden bg-white rounded-3xl border-2 border-pink/30 shadow-md">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-pink-light/70 border-b-2 border-pink/30 text-text-dark font-heading font-bold text-xs sm:text-sm">
            <th class="py-3.5 px-4 sm:px-6">Workshop / Event</th>
            <th class="py-3.5 px-4 sm:px-6">Date & Time</th>
            <th class="py-3.5 px-4 sm:px-6 hidden sm:table-cell">Location</th>
            <th class="py-3.5 px-4 sm:px-6">Admission</th>
            <th class="py-3.5 px-4 sm:px-6 text-right">Action</th>
          </tr>
        </thead>
        <tbody id="events-table-tbody" class="divide-y divide-pink/20 text-xs sm:text-sm">
          {initialEvents.length === 0 ? (
            <tr>
              <td colspan="5" class="py-10 text-center text-text-muted font-heading text-xs sm:text-sm">
                No upcoming events scheduled at the moment.
              </td>
            </tr>
          ) : (
            initialEvents.map((evt) => {
              const eventLink = resolveEventLink(evt.short_link, evt.origin_link);
              return (
                <tr class="hover:bg-cream/70 transition-colors cursor-pointer" data-event-id={evt.id}>
                  <!-- Title & Poster -->
                  <td class="py-3.5 px-4 sm:px-6">
                    <div class="flex items-center gap-3">
                      <img
                        src={getPosterUrl(evt.poster)}
                        alt={evt.title}
                        class="w-12 h-12 rounded-xl object-cover border border-pink/30 shadow-xs shrink-0"
                        loading="lazy"
                        onerror="this.onerror=null; this.src='/images/workshop/flower-bagcharms.jpeg';"
                      />
                      <div>
                        <p class="font-heading font-bold text-text-dark hover:text-pink-deep transition-colors line-clamp-1">
                          {evt.title}
                        </p>
                        {evt.sub_title && (
                          <p class="text-[11px] font-heading font-semibold text-pink-deep">{evt.sub_title}</p>
                        )}
                      </div>
                    </div>
                  </td>

                  <!-- Date & Time -->
                  <td class="py-3.5 px-4 sm:px-6 whitespace-nowrap">
                    <div class="font-heading font-bold text-text-dark">
                      {formatDate(evt.start_date)}
                    </div>
                    <div class="text-[11px] text-text-muted">
                      {evt.start_time ? evt.start_time : 'Time TBA'}
                    </div>
                  </td>

                  <!-- Location -->
                  <td class="py-3.5 px-4 sm:px-6 hidden sm:table-cell text-text-muted">
                    <span class="line-clamp-1">{evt.place || 'Karawang / Online'}</span>
                  </td>

                  <!-- Fee -->
                  <td class="py-3.5 px-4 sm:px-6 whitespace-nowrap font-heading font-bold text-pink-deep">
                    {formatPrice(evt.admission_fee)}
                  </td>

                  <!-- Action button -->
                  <td class="py-3.5 px-4 sm:px-6 text-right whitespace-nowrap">
                    <a
                      href={eventLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      onclick="event.stopPropagation()"
                      class="inline-flex items-center gap-1 bg-pink hover:bg-pink-dark text-text-dark font-heading font-bold text-xs py-1.5 px-3 rounded-xl shadow-xs transition-all hover:scale-105 active:scale-95"
                    >
                      <span>{evt.is_coming_soon ? 'Details' : 'Register'}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- EVENT DETAIL MODAL / POPUP -->
  <div
    id="event-detail-modal"
    class="fixed inset-0 z-[9999] flex items-center justify-center p-3 sm:p-5 bg-black/75 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-event-title"
    data-lenis-prevent
  >
    <!-- Modal Dialog Container -->
    <div
      id="event-detail-dialog"
      class="relative bg-white w-full max-w-3xl max-h-[85vh] sm:max-h-[88vh] rounded-3xl border-2 border-pink/40 shadow-2xl overflow-hidden flex flex-col transform transition-all duration-300 scale-95"
      data-lenis-prevent
    >
      <!-- Close Button Top Right -->
      <button
        id="modal-close-btn"
        type="button"
        class="absolute top-3.5 right-3.5 z-30 w-8 h-8 rounded-full bg-white/95 hover:bg-pink-light border border-pink/40 text-text-muted hover:text-text-dark flex items-center justify-center shadow-sm transition-all hover:scale-105 active:scale-95 cursor-pointer"
        aria-label="Close modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Scrollable Content Body with 2-Column Responsive Layout -->
      <div
        id="modal-scroll-body"
        class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-5 pt-11 sm:p-7 sm:pt-11"
        data-lenis-prevent
        data-lenis-prevent-wheel
        data-lenis-prevent-touch
        style="-webkit-overflow-scrolling: touch; touch-action: pan-y;"
      >
        <div class="flex flex-col md:flex-row gap-5 sm:gap-7 items-start">
          <!-- Left Column: Portrait Poster -->
          <div class="w-full md:w-5/12 max-w-[220px] md:max-w-none mx-auto md:mx-0 shrink-0">
            <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden bg-pink-light/40 border-2 border-pink/30 shadow-md">
              <img
                id="modal-poster"
                src=""
                alt=""
                class="w-full h-full object-cover"
              />
              <div id="modal-status-badge" class="absolute top-3 left-3 z-10">
                <!-- Dynamic Status Badge -->
              </div>
            </div>
          </div>

          <!-- Right Column: Event Details -->
          <div class="flex-1 w-full flex flex-col space-y-4">
            <!-- Date & Time Row (Date on Left, Time on Right) -->
            <div class="flex items-center justify-between gap-2 w-full">
              <div class="inline-flex items-center gap-1.5 text-xs font-heading font-extrabold text-pink-deep bg-pink-light px-3 py-1 rounded-xl border border-pink/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-pink-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span id="modal-date"></span>
              </div>

              <div id="modal-time-wrapper" class="inline-flex items-center gap-1.5 text-xs font-heading font-semibold text-text-dark bg-cream px-3 py-1 rounded-xl border border-pink/20 shrink-0 ml-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span id="modal-time"></span>
              </div>
            </div>

            <!-- Event Title & Subtitle -->
            <div>
              <h3 id="modal-event-title" class="font-heading font-extrabold text-xl sm:text-2xl text-text-dark leading-tight">
              </h3>
              <p id="modal-subtitle" class="text-xs sm:text-sm font-heading font-semibold text-pink-deep mt-1 hidden">
              </p>
            </div>

            <!-- Venue / Location -->
            <div id="modal-location-wrapper" class="flex items-start gap-2 text-xs sm:text-sm text-text-muted bg-pink-light/30 p-2.5 rounded-xl border border-pink/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-pink-deep shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span id="modal-location" class="font-medium"></span>
            </div>

            <!-- Admission Fee Card -->
            <div class="flex items-center justify-between p-3 bg-cream rounded-2xl border border-pink/30">
              <div>
                <span class="text-[10px] uppercase font-heading font-bold text-text-muted block">Admission / Fee</span>
                <span id="modal-price" class="font-heading font-extrabold text-base sm:text-lg text-pink-deep"></span>
              </div>
              <span class="text-[11px] font-heading font-medium text-text-muted">Per Participant</span>
            </div>

            <!-- Event Description -->
            <div class="pt-1">
              <h4 class="font-heading font-bold text-xs uppercase tracking-wider text-text-muted mb-1.5">
                About This Event
              </h4>
              <p id="modal-description" class="text-xs sm:text-sm text-text-dark/90 whitespace-pre-line leading-relaxed">
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 sm:p-5 bg-pink-light/30 border-t-2 border-pink/20 flex items-center justify-between gap-3 shrink-0">
        <button
          id="modal-close-footer-btn"
          type="button"
          class="px-4 py-2 rounded-xl font-heading font-bold text-xs text-text-muted hover:text-text-dark hover:bg-white border border-pink/30 transition-all cursor-pointer"
        >
          Close
        </button>

        <a
          id="modal-register-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-xs sm:text-sm py-2 px-5 rounded-xl shadow-xs hover:scale-105 active:scale-95 transition-all"
        >
          <span id="modal-btn-label">Register Now</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Helper to safely escape text in dynamic HTML
  const escapeHtml = (str: string = '') => {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  };

  const formatDateClient = (dateStr?: string) => {
    if (!dateStr) return 'TBA';
    try {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;
      return d.toLocaleDateString('en-US', {
        weekday: 'short',
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    } catch {
      return dateStr;
    }
  };

  const formatPriceClient = (price?: number | null) => {
    if (!price || price <= 0) return 'Free / TBA';
    return `IDR ${Number(price).toLocaleString('en-US')}`;
  };

  const getPosterUrlClient = (posterPath: string | undefined, apiUrl: string) => {
    if (!posterPath) return '/images/workshop/moru-doll.jpeg';
    if (posterPath.startsWith('http')) return posterPath;
    return `${apiUrl}${posterPath.startsWith('/') ? posterPath : '/' + posterPath}`;
  };

  const resolveEventLinkClient = (shortLink: string | undefined | null, originLink: string | undefined | null) => {
    if (shortLink && shortLink.trim() !== '') {
      let s = shortLink.trim();
      if (s.includes('looca.id')) {
        s = s.replace(/https?:\/\/(?:www\.)?looca\.id/i, 'https://looca-id.com');
      } else if (s.startsWith('/event/') || s.startsWith('/r/')) {
        s = `https://looca-id.com${s}`;
      } else if (!s.startsWith('http://') && !s.startsWith('https://')) {
        s = `https://looca-id.com/event/${s}`;
      }
      return s;
    }
    if (originLink && originLink.trim() !== '') {
      let d = originLink.trim();
      if (!d.startsWith('http://') && !d.startsWith('https://')) {
        d = 'https://' + d;
      }
      return d;
    }
    return 'https://instagram.com/looca_id';
  };

  // Dynamic client-side view toggle, live refresh from API, and Modal Popup Detail
  const initUpcomingEvents = () => {
    const container = document.getElementById('upcoming-events-container');
    const btnCards = document.getElementById('btn-view-cards');
    const btnTable = document.getElementById('btn-view-table');
    const cardsView = document.getElementById('events-cards-view');
    const tableView = document.getElementById('events-table-view');
    const tableTbody = document.getElementById('events-table-tbody');

    const modal = document.getElementById('event-detail-modal');
    const modalDialog = document.getElementById('event-detail-dialog');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalCloseFooterBtn = document.getElementById('modal-close-footer-btn');

    const modalPoster = document.getElementById('modal-poster') as HTMLImageElement | null;
    const modalStatusBadge = document.getElementById('modal-status-badge');
    const modalDate = document.getElementById('modal-date');
    const modalTimeWrapper = document.getElementById('modal-time-wrapper');
    const modalTime = document.getElementById('modal-time');
    const modalSubtitle = document.getElementById('modal-subtitle');
    const modalTitle = document.getElementById('modal-event-title');
    const modalLocationWrapper = document.getElementById('modal-location-wrapper');
    const modalLocation = document.getElementById('modal-location');
    const modalPrice = document.getElementById('modal-price');
    const modalDescription = document.getElementById('modal-description');
    const modalRegisterLink = document.getElementById('modal-register-link') as HTMLAnchorElement | null;
    const modalBtnLabel = document.getElementById('modal-btn-label');

    if (!container || !btnCards || !btnTable || !cardsView || !tableView) return;

    // Move modal directly to <body> so position:fixed and touch scrolling operate at viewport root
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const apiUrl = (container.getAttribute('data-api-url') || 'https://backend.looca-id.com').replace(/\/$/, '');

    // In-memory store for events to feed the modal
    const eventsMap = new Map<number, any>();
    let savedScrollY = 0;

    // Load initial build-time events if present
    try {
      const rawInitial = container.getAttribute('data-initial-events');
      if (rawInitial) {
        const parsed = JSON.parse(rawInitial);
        if (Array.isArray(parsed)) {
          parsed.forEach((evt) => {
            if (evt && evt.id) eventsMap.set(evt.id, evt);
          });
        }
      }
    } catch (e) {
      console.warn('[UpcomingEvents] Failed to parse initial events for modal:', e);
    }

    // Modal display handlers
    const openModal = (evt: any) => {
      if (!modal || !modalDialog) return;

      if (modalPoster) {
        modalPoster.src = getPosterUrlClient(evt.poster, apiUrl);
        modalPoster.alt = evt.title || 'Event Poster';
        modalPoster.onerror = () => {
          modalPoster.src = '/images/workshop/flower-bagcharms.jpeg';
        };
      }

      if (modalStatusBadge) {
        modalStatusBadge.innerHTML = evt.is_coming_soon
          ? `<span class="bg-yellow text-text-dark font-heading font-bold text-xs px-3 py-1 rounded-full shadow-xs border border-yellow-dark/30">Coming Soon</span>`
          : `<span class="bg-pink-deep text-white font-heading font-bold text-xs px-3 py-1 rounded-full shadow-xs border border-white/30">Open Registration</span>`;
      }

      if (modalDate) modalDate.textContent = formatDateClient(evt.start_date);

      if (modalTimeWrapper && modalTime) {
        if (evt.start_time && evt.start_time.trim() !== '') {
          modalTime.textContent = evt.start_time;
          modalTimeWrapper.classList.remove('hidden');
        } else {
          modalTimeWrapper.classList.add('hidden');
        }
      }

      if (modalSubtitle) {
        if (evt.sub_title && evt.sub_title.trim() !== '') {
          modalSubtitle.textContent = evt.sub_title;
          modalSubtitle.classList.remove('hidden');
        } else {
          modalSubtitle.classList.add('hidden');
        }
      }

      if (modalTitle) modalTitle.textContent = evt.title || 'Workshop & Class';

      if (modalLocation && modalLocationWrapper) {
        if (evt.place && evt.place.trim() !== '') {
          modalLocation.textContent = evt.place;
          modalLocationWrapper.classList.remove('hidden');
        } else {
          modalLocation.textContent = 'Karawang / Online / TBA';
          modalLocationWrapper.classList.remove('hidden');
        }
      }

      if (modalPrice) modalPrice.textContent = formatPriceClient(evt.admission_fee);

      if (modalDescription) {
        modalDescription.textContent = evt.description && evt.description.trim() !== ''
          ? evt.description
          : 'Detailed schedule, material kits, and guidance will be provided upon registration.';
      }

      const eventLink = resolveEventLinkClient(evt.short_link, evt.origin_link);
      if (modalRegisterLink) {
        modalRegisterLink.href = eventLink;
      }
      if (modalBtnLabel) {
        modalBtnLabel.textContent = evt.is_coming_soon ? 'View Details' : 'Register Now';
      }

      // Reset modal scroll position to top
      const scrollBody = document.getElementById('modal-scroll-body');
      if (scrollBody) scrollBody.scrollTop = 0;

      // Show modal with animation
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalDialog.classList.remove('scale-95');
      modalDialog.classList.add('scale-100');

      // Pause Lenis smooth scroll & lock body overflow without resetting scroll position
      if ((window as any).__lenis) {
        (window as any).__lenis.stop();
      }
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (!modal || !modalDialog) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modalDialog.classList.add('scale-95');
      modalDialog.classList.remove('scale-100');

      // Restore body overflow & resume Lenis while preserving exact scroll position
      document.body.style.overflow = '';
      if ((window as any).__lenis) {
        (window as any).__lenis.start();
      }
    };

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalCloseFooterBtn) modalCloseFooterBtn.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });

    // Delegated click handler on container for card or table row clicks
    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Don't open modal if user clicked a link (e.g. register button) or interactive button
      if (target.closest('a') || target.closest('button')) return;

      const cardOrRow = target.closest('[data-event-id]') as HTMLElement | null;
      if (!cardOrRow) return;

      const eventId = Number(cardOrRow.getAttribute('data-event-id'));
      if (eventId && eventsMap.has(eventId)) {
        openModal(eventsMap.get(eventId));
      }
    });

    // 1. Toggle between Cards and Table
    btnCards.addEventListener('click', () => {
      cardsView.classList.remove('hidden');
      tableView.classList.add('hidden');

      btnCards.classList.add('bg-pink-deep', 'text-white', 'shadow-xs');
      btnCards.classList.remove('text-text-muted');

      btnTable.classList.remove('bg-pink-deep', 'text-white', 'shadow-xs');
      btnTable.classList.add('text-text-muted');
    });

    btnTable.addEventListener('click', () => {
      cardsView.classList.add('hidden');
      tableView.classList.remove('hidden');

      btnTable.classList.add('bg-pink-deep', 'text-white', 'shadow-xs');
      btnTable.classList.remove('text-text-muted');

      btnCards.classList.remove('bg-pink-deep', 'text-white', 'shadow-xs');
      btnCards.classList.add('text-text-muted');
    });

    // 2. Client-side Live Fetch to reflect realtime admin changes (Add, Edit, Delete)
    const fetchLiveEvents = async () => {
      try {
        const res = await fetch(`${apiUrl}/api/public/events`, {
          headers: { 'Accept': 'application/json' },
        });
        if (!res.ok) return;
        const events = await res.json();
        if (!Array.isArray(events)) return;

        // Clear and update eventsMap
        eventsMap.clear();
        events.forEach((evt: any) => {
          if (evt && evt.id) eventsMap.set(evt.id, evt);
        });

        // Render Cards View
        if (events.length === 0) {
          cardsView.innerHTML = `
            <div class="col-span-full py-12 px-6 bg-white/80 rounded-3xl border-2 border-dashed border-pink/40 text-center flex flex-col items-center justify-center">
              <div class="w-14 h-14 rounded-full bg-pink-light flex items-center justify-center mb-3 text-pink-deep">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <h4 class="font-heading font-bold text-lg text-text-dark mb-1">No Upcoming Events Right Now</h4>
              <p class="text-xs sm:text-sm text-text-muted max-w-md">All upcoming workshops have concluded or are being scheduled. Check back soon or follow us on Instagram for next schedule announcements!</p>
              <a href="https://instagram.com/looca_id" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-xs py-2 px-4 rounded-xl shadow-xs transition-all hover:scale-105">
                <span>Follow @looca_id on Instagram</span>
              </a>
            </div>
          `;
          if (tableTbody) {
            tableTbody.innerHTML = `
              <tr>
                <td colspan="5" class="py-10 text-center text-text-muted font-heading text-xs sm:text-sm">
                  No upcoming events scheduled at the moment.
                </td>
              </tr>
            `;
          }
        } else {
          // Render Live Cards
          cardsView.innerHTML = events.map((evt: any, idx: number) => {
            const isEven = idx % 2 === 0;
            const washiColor = isEven ? 'bg-yellow/90' : 'bg-pink/90';
            const washiRotate = isEven ? '-rotate-2' : 'rotate-2';
            const cardRotate = idx % 3 === 0 ? '-rotate-1 hover:rotate-0' : idx % 3 === 1 ? 'rotate-1 hover:rotate-0' : 'hover:-rotate-1';
            const eventLink = resolveEventLinkClient(evt.short_link, evt.origin_link);
            const poster = getPosterUrlClient(evt.poster, apiUrl);
            const dateStr = formatDateClient(evt.start_date);
            const priceStr = formatPriceClient(evt.admission_fee);

            return `
              <div
                class="event-card relative bg-white rounded-3xl p-5 border-2 border-pink/30 shadow-md ${cardRotate} transition-all duration-300 flex flex-col justify-between group hover:shadow-xl hover:border-pink-deep/50 cursor-pointer"
                data-event-id="${evt.id}"
              >
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-24 h-6 ${washiColor} ${washiRotate} rounded-sm shadow-xs z-20 flex items-center justify-center pointer-events-none">
                  <span class="text-[9px] font-heading font-bold text-text-dark opacity-75">Workshop</span>
                </div>

                <div>
                  <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden bg-pink-light/50 border border-pink/30 mb-4 shadow-inner">
                    <img
                      src="${poster}"
                      alt="${escapeHtml(evt.title)}"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      onerror="this.onerror=null; this.src='/images/workshop/flower-bagcharms.jpeg';"
                    />

                    <div class="absolute top-2.5 left-2.5 z-10">
                      ${evt.is_coming_soon ? `
                        <span class="bg-yellow text-text-dark font-heading font-bold text-[11px] px-2.5 py-0.5 rounded-full shadow-xs border border-yellow-dark/30">
                          Coming Soon
                        </span>
                      ` : `
                        <span class="bg-pink-deep text-white font-heading font-bold text-[11px] px-2.5 py-0.5 rounded-full shadow-xs border border-white/30">
                          Open Registration
                        </span>
                      `}
                    </div>

                  </div>

                  <!-- Date & Time Row -->
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="inline-flex items-center gap-1.5 text-xs font-heading font-extrabold text-pink-deep bg-pink-light px-2.5 py-1 rounded-xl border border-pink/30">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-pink-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      <span>${dateStr}</span>
                    </div>

                    ${evt.start_time ? `
                      <div class="inline-flex items-center gap-1 text-[11px] font-heading font-semibold text-text-muted bg-cream px-2 py-0.5 rounded-lg border border-pink/20 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>${escapeHtml(evt.start_time)}</span>
                      </div>
                    ` : ''}
                  </div>

                  <!-- Title -->
                  <h4 class="font-heading font-bold text-base sm:text-lg text-text-dark leading-snug mb-1 group-hover:text-pink-deep transition-colors line-clamp-1" title="${escapeHtml(evt.title)}">
                    ${escapeHtml(evt.title)}
                  </h4>

                  <!-- Sub Title below Title -->
                  ${evt.sub_title ? `
                    <p class="text-xs font-heading font-semibold text-pink-deep mb-2 line-clamp-1">
                      ${escapeHtml(evt.sub_title)}
                    </p>
                  ` : ''}

                  ${evt.description ? `
                    <p class="text-xs text-text-muted leading-relaxed line-clamp-2 mb-3">
                      ${escapeHtml(evt.description)}
                    </p>
                  ` : ''}

                  ${evt.place ? `
                    <div class="flex items-start gap-1.5 text-[11px] text-text-muted mb-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-pink-deep shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      <span class="line-clamp-1">${escapeHtml(evt.place)}</span>
                    </div>
                  ` : ''}
                </div>

                <div class="pt-3 border-t-2 border-dashed border-pink/30 mt-auto flex items-center justify-between gap-3">
                  <div>
                    <span class="text-[10px] uppercase font-heading font-bold text-text-muted block">Admission</span>
                    <span class="font-heading font-extrabold text-sm text-pink-deep">
                      ${priceStr}
                    </span>
                  </div>

                  <a
                    href="${eventLink}"
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation()"
                    class="inline-flex items-center gap-1.5 bg-yellow hover:bg-yellow-dark text-text-dark font-heading font-bold text-xs py-2 px-3.5 rounded-xl shadow-xs hover:scale-105 active:scale-95 transition-all"
                  >
                    <span>${evt.is_coming_soon ? 'Details' : 'Register'}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            `;
          }).join('');

          // Render Live Table Rows
          if (tableTbody) {
            tableTbody.innerHTML = events.map((evt: any) => {
              const eventLink = resolveEventLinkClient(evt.short_link, evt.origin_link);
              const poster = getPosterUrlClient(evt.poster, apiUrl);
              const dateStr = formatDateClient(evt.start_date);
              const priceStr = formatPriceClient(evt.admission_fee);

              return `
                <tr class="hover:bg-cream/70 transition-colors cursor-pointer" data-event-id="${evt.id}">
                  <td class="py-3.5 px-4 sm:px-6">
                    <div class="flex items-center gap-3">
                      <img
                        src="${poster}"
                        alt="${escapeHtml(evt.title)}"
                        class="w-12 h-12 rounded-xl object-cover border border-pink/30 shadow-xs shrink-0"
                        loading="lazy"
                        onerror="this.onerror=null; this.src='/images/workshop/flower-bagcharms.jpeg';"
                      />
                      <div>
                        <p class="font-heading font-bold text-text-dark hover:text-pink-deep transition-colors line-clamp-1">
                          ${escapeHtml(evt.title)}
                        </p>
                        ${evt.sub_title ? `
                          <p class="text-[11px] font-heading font-semibold text-pink-deep">${escapeHtml(evt.sub_title)}</p>
                        ` : ''}
                      </div>
                    </div>
                  </td>

                  <td class="py-3.5 px-4 sm:px-6 whitespace-nowrap">
                    <div class="font-heading font-bold text-text-dark">
                      ${dateStr}
                    </div>
                    <div class="text-[11px] text-text-muted">
                      ${evt.start_time ? escapeHtml(evt.start_time) : 'Time TBA'}
                    </div>
                  </td>

                  <td class="py-3.5 px-4 sm:px-6 hidden sm:table-cell text-text-muted">
                    <span class="line-clamp-1">${escapeHtml(evt.place || 'Karawang / Online')}</span>
                  </td>

                  <td class="py-3.5 px-4 sm:px-6 whitespace-nowrap font-heading font-bold text-pink-deep">
                    ${priceStr}
                  </td>

                  <td class="py-3.5 px-4 sm:px-6 text-right whitespace-nowrap">
                    <a
                      href="${eventLink}"
                      target="_blank"
                      rel="noopener noreferrer"
                      onclick="event.stopPropagation()"
                      class="inline-flex items-center gap-1 bg-pink hover:bg-pink-dark text-text-dark font-heading font-bold text-xs py-1.5 px-3 rounded-xl shadow-xs transition-all hover:scale-105 active:scale-95"
                    >
                      <span>${evt.is_coming_soon ? 'Details' : 'Register'}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </td>
                </tr>
              `;
            }).join('');
          }
        }
      } catch (e) {
        console.warn('[UpcomingEvents] Live fetch notice:', e);
      }
    };

    fetchLiveEvents();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUpcomingEvents);
  } else {
    initUpcomingEvents();
  }
  document.addEventListener('astro:page-load', initUpcomingEvents);
</script>
