---
// Services.astro (Services & Alur Pemesanan)
---
<section id="services" class="relative py-20 lg:py-28 px-4 sm:px-8 bg-gradient-to-b from-cream via-yellow-light/40 to-white overflow-hidden">
  <div class="max-w-6xl mx-auto">
    
    <!-- Part 1: Product & Service Pill Cloud (Inspired by original wavy banner) -->
    <div class="services-header text-center mb-16">
      <div class="inline-block bg-yellow text-text-dark font-handwriting text-xl sm:text-2xl px-6 py-2 rounded-full shadow-md -rotate-1 mb-4">
        Product and service ✨
      </div>
      <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-text-dark">
        Apa Saja yang Kami Hadirkan?
      </h2>
      <p class="text-text-muted mt-2 max-w-lg mx-auto text-sm sm:text-base">
        Koleksi aksesori dan merchandise yang dapat dikustomisasi sesuai identitas unikmu.
      </p>

      <!-- Pill Cloud / Tag Cloud -->
      <div class="service-tags flex flex-wrap justify-center items-center gap-3 sm:gap-4 max-w-4xl mx-auto mt-8">
        <span class="service-pill bg-white border-2 border-pink-dark text-pink-deep font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          💍 Bracelet & Ring
        </span>
        <span class="service-pill bg-yellow text-text-dark font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          🎒 Bagcharms
        </span>
        <span class="service-pill bg-white border-2 border-yellow text-text-dark font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          ✨ Custom Merch
        </span>
        <span class="service-pill bg-pink-deep text-white font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          🏢 Corporate Merch
        </span>
        <span class="service-pill bg-blue-soft/50 border border-blue-400 text-blue-900 font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          📱 Lanyard & Strap HP / Bag
        </span>
        <span class="service-pill bg-white border-2 border-pink text-text-dark font-heading font-bold text-sm sm:text-base px-6 py-2.5 rounded-full shadow-sm hover:scale-105 transition-all cursor-default">
          🎨 Workshop Creative
        </span>
        <span class="service-pill bg-yellow-light border border-yellow text-yellow-dark font-heading font-semibold text-xs sm:text-sm px-4 py-2 rounded-full shadow-sm">
          🌟 Free Consultation
        </span>
      </div>
    </div>

    <!-- Part 2: Alur Pemesanan Custom Items (8 Steps from original site) -->
    <div class="alur-pemesanan-wrapper mt-20 pt-12 border-t-2 border-dashed border-pink/50">
      <div class="text-center mb-14">
        <span class="bg-[#89CFF0] text-white font-handwriting text-xl sm:text-2xl px-6 py-1.5 rounded-full shadow-md inline-block mb-3">
          Alur Pemesanan
        </span>
        <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-text-dark">
          Custom Items Step-by-Step
        </h3>
        <p class="text-xs sm:text-sm text-text-muted mt-2">
          Proses transparan & mudah dari konsep hingga pesanan sampai di tangan Anda.
        </p>
      </div>

      <!-- 8 Steps Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Step 1 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            01
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📋</div>
          <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            R&D
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Diskusi kebutuhan, konsep desain, pemilihan material, dan detail produk yang diinginkan.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            02
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📦</div>
          <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            SAMPLING
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Free sampling* dan terbuka untuk pengiriman hasil sampling untuk dicek langsung.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            03
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">📱</div>
          <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            DP 50%
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Pembayaran uang muka 50% dari total pesanan untuk memulai proses produksi.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            04
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">⚙️</div>
          <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            PRODUKSI MASSAL
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Proses produksi massal dilakukan sesuai spesifikasi dan timeline yang disepakati bersama.
          </p>
        </div>

        <!-- Step 5 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            05
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">✅</div>
          <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            SELESAI (QC)
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Produksi selesai dan produk melewati proses quality control ketat sebelum ke tahap berikutnya.
          </p>
        </div>

        <!-- Step 6 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-blue-soft/40 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-[#5DADE2] text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            06
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">🧾</div>
          <div class="bg-blue-soft/20 text-blue-700 text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            PELUNASAN
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Pembayaran pelunasan pesanan dilakukan sebelum pesanan siap diberangkatkan.
          </p>
        </div>

        <!-- Step 7 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-pink/30 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-pink-deep text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            07
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">🚚</div>
          <div class="bg-pink-light text-pink-deep text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            PENGIRIMAN
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Pesanan dikirim ke alamat tujuan dengan standar packaging yang aman, rapi, dan cantik.
          </p>
        </div>

        <!-- Step 8 -->
        <div class="step-card bg-white p-6 rounded-3xl border border-yellow/40 shadow-sm relative group hover:shadow-md transition-all">
          <span class="step-number absolute -top-3 -left-3 w-9 h-9 rounded-full bg-yellow-dark text-white font-heading font-bold flex items-center justify-center text-sm shadow">
            08
          </span>
          <div class="text-3xl mb-3 text-center group-hover:scale-110 transition-transform">💌</div>
          <div class="bg-yellow-light text-yellow-dark text-center font-heading font-bold text-xs uppercase tracking-wider py-1 rounded-full mb-3">
            FEEDBACK
          </div>
          <p class="text-xs text-text-muted text-center leading-relaxed">
            Kami sangat menghargai ulasan dan feedback klien untuk terus menyempurnakan karya kami.
          </p>
        </div>

      </div>

      <!-- Free sampling footnote -->
      <div class="mt-8 text-center">
        <span class="inline-block bg-white border border-pink-deep/30 px-5 py-2 rounded-full text-xs text-pink-deep font-heading font-semibold shadow-sm">
          🌸 *Free sampling berlaku untuk minimum order 100 pcs.
        </span>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initServices = () => {
    // Pill badges animation
    gsap.fromTo(
      '.service-pill',
      { opacity: 0, scale: 0.7 },
      {
        opacity: 1,
        scale: 1,
        stagger: 0.05,
        duration: 0.5,
        ease: 'back.out(1.8)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.service-tags',
          start: 'top 90%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Step cards stagger
    gsap.fromTo(
      '.step-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.08,
        duration: 0.6,
        ease: 'power2.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '.alur-pemesanan-wrapper',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.service-pill, .step-card').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServices);
  } else {
    initServices();
  }
</script>
