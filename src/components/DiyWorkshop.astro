---

<section id="diy-workshop" class="relative py-16 sm:py-24 lg:py-28 px-3 sm:px-8 bg-gradient-to-b from-cream via-white to-cream overflow-hidden">
  
  <!-- Decorative Elements -->
  <div class="absolute top-12 left-4 sm:left-12 w-12 sm:w-16 opacity-40 pointer-events-none">
    <img src="/decorations/cherry.svg" alt="cherry" class="w-full" />
  </div>
  <div class="absolute bottom-10 right-4 sm:right-12 w-16 sm:w-24 opacity-30 pointer-events-none animate-spin-slow">
    <img src="/decorations/flower-daisy.svg" alt="flower" class="w-full" />
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 bg-[#89CFF0] text-white font-handwriting text-lg sm:text-2xl px-5 sm:px-6 py-1.5 rounded-full shadow-md -rotate-1 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5 fill-white" viewBox="0 0 24 24">
          <path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z"/>
        </svg>
        <span>Interactive Showcase</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-4xl lg:text-5xl font-extrabold text-text-dark tracking-tight">
        DIY Kits & Workshop Videos
      </h2>
      <p class="text-text-muted mt-2 sm:mt-3 max-w-xl mx-auto text-xs sm:text-base leading-relaxed">
        Watch hands-on tutorial snippets and creative workshop highlights. Click any card to stream the full portrait video!
      </p>
    </div>

    <!-- 6 Cards Grid: 2 cols on mobile, 3 cols on tablet/desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
      {diyWorkshops.map((item) => (
        <div 
          class="diy-card group bg-white rounded-2xl sm:rounded-3xl p-3 sm:p-4 border border-pink/25 shadow-xs hover:shadow-xl hover:border-pink/50 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Top Area: Video / Thumbnail Media Container -->
          <div>
            <div 
              class="relative w-full aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-cream/70 mb-2.5 sm:mb-4 cursor-pointer video-trigger-container"
              data-has-video={item.hasVideo ? 'true' : 'false'}
              data-video-src={item.video}
              data-video-title={item.title}
              data-video-cat={item.category}
            >
              <!-- Thumbnail Image (diy1.jpeg - diy6.jpeg) -->
              <img 
                src={item.thumbnail} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500" 
                loading="lazy"
              />

              <!-- Overlay Gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent group-hover:from-black/70 transition-all"></div>

              <!-- Top Left Badge -->
              <div class="absolute top-2 left-2 sm:top-3 sm:left-3 z-10">
                <span class={`font-heading font-extrabold text-[8px] sm:text-[10px] px-2 sm:px-2.5 py-0.5 rounded-full shadow-xs ${item.badgeColor}`}>
                  {item.badge}
                </span>
              </div>

              <!-- Play Button / Status Pill -->
              {item.hasVideo ? (
                <div class="absolute inset-0 flex items-center justify-center z-10">
                  <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-full bg-white/90 group-hover:bg-pink-deep text-pink-deep group-hover:text-white flex items-center justify-center shadow-lg transition-all transform group-hover:scale-115">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-7 sm:h-7 translate-x-0.5 fill-current" viewBox="0 0 24 24">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                </div>
              ) : (
                <div class="absolute inset-0 flex items-center justify-center z-10">
                  <div class="bg-black/60 backdrop-blur-sm text-white font-heading font-bold text-[9px] sm:text-xs px-2.5 py-1 rounded-full border border-white/30 flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Video Soon</span>
                  </div>
                </div>
              )}

              <!-- Bottom Duration / Stream Info Tag -->
              <div class="absolute bottom-2 right-2 sm:bottom-3 sm:right-3 z-10 flex items-center gap-1 bg-black/65 backdrop-blur-sm text-white px-2 py-0.5 rounded-md text-[8px] sm:text-[10px] font-heading font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="10 8 16 12 10 16 10 8"></polygon>
                </svg>
                <span>{item.hasVideo ? 'Watch Video' : 'Offline Session'}</span>
              </div>
            </div>

            <!-- Category -->
            <div class="mb-1 sm:mb-1.5 px-0.5 sm:px-1">
              <span class="text-[9px] sm:text-[11px] font-heading font-semibold uppercase tracking-wider text-pink-deep">
                {item.category}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-heading font-bold text-xs sm:text-base text-text-dark leading-snug mb-1 sm:mb-2 px-0.5 sm:px-1 group-hover:text-pink-deep transition-colors line-clamp-1" title={item.title}>
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-[10px] sm:text-xs text-text-muted leading-relaxed mb-3 sm:mb-4 px-0.5 sm:px-1 line-clamp-2">
              {item.description}
            </p>
          </div>

          <!-- Action Buttons Area -->
          <div class="pt-2.5 sm:pt-3 border-t border-gray-100 mt-auto flex flex-col gap-1.5">
            {item.hasVideo ? (
              <button
                type="button"
                class="stream-btn w-full bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-[10px] sm:text-xs py-2 sm:py-2.5 px-2 sm:px-3 rounded-lg sm:rounded-xl shadow-xs flex items-center justify-center gap-1.5 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
                data-video-src={item.video}
                data-video-title={item.title}
                data-video-cat={item.category}
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 fill-current" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Play Video</span>
              </button>
            ) : (
              <a 
                href={item.actionLink}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-yellow-light hover:bg-yellow text-text-dark font-heading font-bold text-[10px] sm:text-xs py-2 sm:py-2.5 px-2 sm:px-3 rounded-lg sm:rounded-xl shadow-xs flex items-center justify-center gap-1.5 hover:scale-[1.02] active:scale-[0.98] transition-all"
              >
                <span>Inquire Class</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>

  <!-- TikTok / Reels Style Portrait Video Modal -->
  <div 
    id="video-stream-modal" 
    class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-2 sm:p-4 transition-all duration-300"
    role="dialog"
    aria-modal="true"
  >
    <!-- Portrait Phone Frame Container (Max width approx 400px, 9:16 aspect ratio) -->
    <div class="relative w-full max-w-[390px] h-[90vh] max-h-[780px] bg-black rounded-3xl sm:rounded-[36px] overflow-hidden shadow-2xl border border-white/20 flex flex-col justify-between">
      
      <!-- Video Element: Fills entire portrait frame -->
      <video 
        id="stream-video-element" 
        playsinline 
        loop
        preload="metadata"
        class="absolute inset-0 w-full h-full object-cover cursor-pointer z-0"
      >
        <source id="video-source-element" src="" type="video/mp4" />
        Your browser does not support the video tag.
      </video>

      <!-- Center Play/Pause Indicator (Overlay when paused) -->
      <div id="video-paused-overlay" class="absolute inset-0 flex items-center justify-center pointer-events-none z-10 hidden">
        <div class="w-16 h-16 rounded-full bg-black/50 backdrop-blur-sm text-white flex items-center justify-center border border-white/20 shadow-xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 translate-x-0.5 fill-current" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </div>
      </div>

      <!-- Top Overlay: Header Bar with Category, Title & Close Button -->
      <div class="relative z-20 w-full p-4 sm:p-5 bg-gradient-to-b from-black/80 via-black/40 to-transparent flex items-start justify-between">
        <div class="flex items-center gap-2.5">
          <img src="/logo.png" alt="Looca" class="w-9 h-9 rounded-full border border-pink-deep object-cover shadow-sm" />
          <div class="text-left">
            <span id="modal-video-cat" class="text-[10px] font-heading font-extrabold uppercase tracking-widest text-[#89CFF0] block">Workshop</span>
            <span class="text-white text-xs font-heading font-bold flex items-center gap-1">
              <span>looca_id</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-[#5DADE2]" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </span>
          </div>
        </div>

        <button 
          id="close-video-modal"
          class="w-9 h-9 rounded-full bg-black/40 backdrop-blur-md hover:bg-black/70 border border-white/30 flex items-center justify-center text-white transition-all cursor-pointer focus:outline-none"
          aria-label="Close Video Player"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Right Floating Action Sidebar (TikTok Style: Like, Sound, WhatsApp) -->
      <div class="absolute right-3 bottom-24 z-20 flex flex-col items-center gap-4 text-white">
        <!-- Sound Toggle -->
        <button 
          id="sound-toggle-btn"
          class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:scale-110 active:scale-95 transition-all cursor-pointer"
          aria-label="Toggle Sound"
        >
          <svg id="sound-unmuted-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <svg id="sound-muted-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>

        <!-- Like Heart -->
        <button 
          id="tiktok-like-btn"
          class="flex flex-col items-center gap-1 group hover:scale-110 active:scale-90 transition-all cursor-pointer"
        >
          <div class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md border border-white/20 flex items-center justify-center text-white group-hover:text-pink-deep">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <span class="text-[9px] font-heading font-semibold text-white/90">Love</span>
        </button>

        <!-- Chat / Inquire -->
        <a 
          id="modal-inquire-icon"
          href="https://wa.me/6281215312939" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-1 group hover:scale-110 active:scale-90 transition-all"
        >
          <div class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-white" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </div>
          <span class="text-[9px] font-heading font-semibold text-white/90">Inquire</span>
        </a>
      </div>

      <!-- Bottom Overlay: Title, Description & Action CTA Button -->
      <div class="relative z-20 w-full p-4 sm:p-5 bg-gradient-to-t from-black/95 via-black/60 to-transparent">
        <h4 id="modal-video-title" class="font-heading font-bold text-base sm:text-lg text-white leading-snug drop-shadow-md mb-1.5">
          DIY Video Player
        </h4>
        <p class="text-[11px] sm:text-xs text-white/80 line-clamp-2 leading-relaxed mb-3 drop-shadow-sm">
          Watch hands-on workshop highlights and DIY tutorial guides by Looca ID. Tap screen to pause/play.
        </p>

        <a 
          id="modal-inquire-link"
          href="https://wa.me/6281215312939" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 bg-pink-deep hover:bg-pink-dark text-white font-heading font-bold text-xs sm:text-sm py-2.5 px-4 rounded-xl shadow-lg transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <span>Book Workshop / Order DIY Kit</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>

</section>

<script>
  const initVideoPlayer = () => {
    const modal = document.getElementById('video-stream-modal');
    const closeBtn = document.getElementById('close-video-modal');
    const video = document.getElementById('stream-video-element') as HTMLVideoElement | null;
    const source = document.getElementById('video-source-element') as HTMLSourceElement | null;
    const modalTitle = document.getElementById('modal-video-title');
    const modalCat = document.getElementById('modal-video-cat');
    const modalInquire = document.getElementById('modal-inquire-link') as HTMLAnchorElement | null;
    const modalInquireIcon = document.getElementById('modal-inquire-icon') as HTMLAnchorElement | null;
    const pausedOverlay = document.getElementById('video-paused-overlay');
    const soundBtn = document.getElementById('sound-toggle-btn');
    const soundUnmutedIcon = document.getElementById('sound-unmuted-icon');
    const soundMutedIcon = document.getElementById('sound-muted-icon');
    const likeBtn = document.getElementById('tiktok-like-btn');

    const triggers = document.querySelectorAll('.video-trigger-container, .stream-btn');

    const updateSoundIcons = () => {
      if (!video) return;
      if (video.muted) {
        soundUnmutedIcon?.classList.add('hidden');
        soundMutedIcon?.classList.remove('hidden');
      } else {
        soundUnmutedIcon?.classList.remove('hidden');
        soundMutedIcon?.classList.add('hidden');
      }
    };

    const toggleSound = (e?: Event) => {
      e?.stopPropagation();
      if (!video) return;
      video.muted = !video.muted;
      updateSoundIcons();
    };

    const togglePlayPause = () => {
      if (!video) return;
      if (video.paused) {
        video.play();
        pausedOverlay?.classList.add('hidden');
      } else {
        video.pause();
        pausedOverlay?.classList.remove('hidden');
      }
    };

    const openVideo = (src: string, title: string, cat: string) => {
      if (!modal || !video || !source) return;

      source.src = src;
      const isMov = src.toLowerCase().endsWith('.mov');
      source.type = isMov ? 'video/quicktime' : 'video/mp4';

      video.muted = false; // default unmuted with sound
      video.load();
      pausedOverlay?.classList.add('hidden');
      updateSoundIcons();

      video.play().catch(() => {
        // Fallback for browser autoplay policies: mute and play
        video.muted = true;
        updateSoundIcons();
        video.play().catch(() => {});
      });

      if (modalTitle) modalTitle.textContent = title;
      if (modalCat) modalCat.textContent = cat;
      
      const whatsappUrl = `https://wa.me/6281215312939?text=${encodeURIComponent(`Halo Looca ID, saya tertarik dengan workshop/DIY: ${title}`)}`;
      if (modalInquire) modalInquire.href = whatsappUrl;
      if (modalInquireIcon) modalInquireIcon.href = whatsappUrl;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeVideo = () => {
      if (!modal || !video) return;
      video.pause();
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        const target = trigger as HTMLElement;
        const hasVideo = target.getAttribute('data-has-video') !== 'false';
        const src = target.getAttribute('data-video-src');
        const title = target.getAttribute('data-video-title') || 'DIY Workshop';
        const cat = target.getAttribute('data-video-cat') || 'Workshop';

        if (hasVideo && src) {
          e.preventDefault();
          openVideo(src, title, cat);
        }
      });
    });

    // Tap video to toggle play/pause like TikTok
    video?.addEventListener('click', togglePlayPause);
    soundBtn?.addEventListener('click', toggleSound);

    // Heart like animation effect
    likeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      likeBtn.classList.toggle('text-pink-deep');
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeVideo();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeVideo();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeVideo();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoPlayer);
  } else {
    initVideoPlayer();
  }
</script>
