---
// About.astro
---
<section id="about" class="relative py-16 sm:py-20 lg:py-28 px-4 sm:px-8 bg-pink-light overflow-hidden">
  <!-- Subtle Background Daisy -->
  <div class="absolute -right-8 sm:-right-12 top-8 sm:top-12 w-28 sm:w-48 opacity-20 sm:opacity-25 pointer-events-none animate-spin-slow">
    <img src="/decorations/flower-daisy.svg" alt="daisy" class="w-full" />
  </div>

  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-16 items-center">
      
      <!-- Mobile Only Title (Title -> Image -> Text) -->
      <div class="block lg:hidden w-full text-center order-1 mb-2">
        <div class="flex items-center justify-center gap-3.5 mb-4">
          <img 
            src="/logo.png" 
            alt="Looca ID Official Logo" 
            class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl object-cover shadow-md border-2 border-pink/60" 
          />
          <span class="bg-pink-deep text-white font-heading font-extrabold text-sm sm:text-base px-5 py-2 rounded-full shadow-sm">
            Looca_id
          </span>
        </div>
        <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-text-dark leading-tight">
          Looca is Loove craft, <br/>Loove local product
        </h2>
      </div>

      <!-- Left: Visual Product Showcase (Card Slider) -->
      <div class="about-visual lg:col-span-5 relative w-full flex justify-center order-2 lg:order-1 perspective-[1200px]">
        <!-- Background blob decoration -->
        <div class="absolute inset-0 bg-pink/50 rounded-4xl -rotate-3 transform scale-105"></div>
        
        <!-- Card Stack Container -->
        <div class="card-stack relative z-10 w-full max-w-[280px] sm:max-w-[340px] aspect-square">
          {
            [7, 6, 5, 4, 3, 2, 1].map((num) => (
              <div class="stack-card absolute inset-0 bg-white p-2.5 sm:p-3.5 rounded-3xl shadow-xl border-4 border-white origin-bottom flex flex-col" style={`z-index: ${8 - num};`}>
                <div class="relative w-full h-full rounded-2xl overflow-hidden shadow-inner bg-gray-100">
                  <img 
                    src={`/images/about${num}.jpeg`} 
                    alt={`Looca About ${num}`} 
                    class="w-full h-full object-cover" 
                  />
                  <!-- Overlay text only on the first card visually -->
                  {num === 7 && (
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex flex-col justify-end p-4 sm:p-5 text-white">
                      <div class="inline-block self-start bg-pink-deep/90 backdrop-blur-sm px-3 py-1 rounded-full text-[10px] sm:text-xs font-heading font-bold mb-1 shadow-sm">
                        Handmade With Loove 💖 
                      </div>
                      <p class="text-[10px] sm:text-xs text-white/90 font-sans leading-relaxed">
                        Handmade from local crafter
                      </p>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
          
          <!-- Decorative mini badge -->
          <div class="absolute -top-3 -left-3 z-50 bg-yellow text-text-dark font-handwriting text-xs sm:text-sm px-3.5 py-1 rounded-full shadow-md transform -rotate-6">
            Since 2023
          </div>
        </div>
      </div>

      <!-- Right: About Story & Category Badges -->
      <div class="about-content lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left order-3 lg:order-2">
        
        <!-- Desktop Only Title -->
        <div class="hidden lg:block w-full mb-6">
          <div class="flex items-center justify-start gap-4 mb-5">
            <img 
              src="/logo.png" 
              alt="Looca ID Official Logo" 
              class="w-16 h-16 xl:w-20 xl:h-20 rounded-2xl object-cover shadow-md border-2 border-pink/60 hover:rotate-6 transition-transform" 
            />
            <span class="bg-pink-deep text-white font-heading font-extrabold text-lg xl:text-xl px-6 py-2 rounded-full shadow-sm">
              Looca_id
            </span>
          </div>
          <h2 class="font-heading text-4xl xl:text-5xl font-extrabold text-text-dark leading-[1.15]">
            Looca is Loove craft, <br/>Loove local product
          </h2>
        </div>

        <p class="font-sans text-sm sm:text-base lg:text-lg text-text-dark/80 leading-relaxed mb-8 max-w-lg lg:max-w-none text-justify lg:text-left">
          Creative items brand that sell <strong>fashion product</strong>, <strong>handmade accessories</strong>, <strong>merchandise</strong>, and <strong>creative workshop</strong> from Indonesia since 2023. We are committed to creating products that are unique, of high quality, and impactful for the surrounding community.
        </p>

        <!-- 4 Core Service / Category Badges -->
        <div class="space-y-3 w-full flex flex-col items-center lg:items-start">
          <span class="text-xs font-heading font-bold uppercase tracking-wider text-text-muted block">
            Product & Services:
          </span>
          <div class="flex flex-wrap justify-center lg:justify-start gap-2 sm:gap-3">
            <div class="about-badge bg-pink-deep hover:bg-pink-dark text-white font-heading font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-md cursor-pointer hover:scale-105 transition-all">
              👗 Fashion
            </div>
            <div class="about-badge bg-pink-deep hover:bg-pink-dark text-white font-heading font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-md cursor-pointer hover:scale-105 transition-all">
              💍 Accessories / Bagcharm
            </div>
            <div class="about-badge bg-pink-deep hover:bg-pink-dark text-white font-heading font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-md cursor-pointer hover:scale-105 transition-all">
              🎁 Merchandise / Souvenir
            </div>
            <div class="about-badge bg-pink-deep hover:bg-pink-dark text-white font-heading font-semibold text-xs sm:text-sm px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-md cursor-pointer hover:scale-105 transition-all">
              🎨 Creative Workshop
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAbout = () => {
    // Reveal Animations
    gsap.fromTo(
      '.about-visual',
      { opacity: 0, x: -50 },
      {
        opacity: 1,
        x: 0,
        duration: 0.9,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#about',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '.about-content',
      { opacity: 0, x: 50 },
      {
        opacity: 1,
        x: 0,
        duration: 0.9,
        ease: 'power3.out',
        delay: 0.2,
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#about',
          start: 'top 85%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '.about-badge',
      { opacity: 0, scale: 0.7 },
      {
        opacity: 1,
        scale: 1,
        duration: 0.5,
        stagger: 0.08,
        ease: 'back.out(2)',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#about',
          start: 'top 75%',
          toggleActions: 'play none none none',
          once: true,
        },
      }
    );

    // Failsafe
    setTimeout(() => {
      document.querySelectorAll('.about-visual, .about-content, .about-badge').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 1200);
  };

  const initCardSlider = () => {
    const stack = document.querySelector('.card-stack');
    if (!stack) return;
    const cards = Array.from(stack.querySelectorAll('.stack-card'));
    if (cards.length === 0) return;

    // We rely on the DOM order to rotate them. The first element in DOM was numbered 7, last was 1.
    // In our DOM, index 0 is about7, index 6 is about1.
    // We want to visually stack them so the "first" in the array is on top.

    const updateCards = () => {
      cards.forEach((card, i) => {
        const el = card as HTMLElement;
        el.style.transition = 'transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1), opacity 0.6s';
        el.style.zIndex = (cards.length - i).toString();
        
        if (i === 0) {
          // Top card
          el.style.transform = 'translateX(0) scale(1) translateY(0) rotate(0deg)';
          el.style.opacity = '1';
        } else if (i === 1) {
          // Second card
          el.style.transform = 'translateX(0) scale(0.95) translateY(-12px) rotate(-2deg)';
          el.style.opacity = '0.85';
        } else if (i === 2) {
          // Third card
          el.style.transform = 'translateX(0) scale(0.9) translateY(-24px) rotate(2deg)';
          el.style.opacity = '0.6';
        } else {
          // Hidden cards
          el.style.transform = 'translateX(0) scale(0.85) translateY(-36px)';
          el.style.opacity = '0';
        }
      });
    };

    updateCards();

    setInterval(() => {
      // Animate top card away
      const topCard = cards[0] as HTMLElement;
      topCard.style.transform = 'translateX(120%) rotate(15deg)';
      topCard.style.opacity = '0';

      setTimeout(() => {
        // Move top card to the back of the DOM array
        const removed = cards.shift();
        if (removed) cards.push(removed);
        // Remove from DOM and append to back to keep things clean? 
        // Not strictly necessary since we override z-index, but good practice if needed.
        // Let's just use the array rotation for styles
        updateCards();
      }, 400); // wait for throw away animation

    }, 3500); // Rotate every 3.5 seconds
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initAbout();
      initCardSlider();
    });
  } else {
    initAbout();
    initCardSlider();
  }
</script>
