---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { PUBLIC_API_URL } from '../lib/api';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Looca ID - Creative items brand that sell fashion product, handmade accessories, merchandise, and creative workshop from Indonesia since 2023." />

    <meta property="og:title" content="Handmade Fashion, Accessories & Creative Workshop | Looca ID" />
    <meta
      property="og:description"
      content="Creative items brand that sell fashion product, handmade accessories, merchandise, and creative workshop from Indonesia since 2023."
    />
    <meta property="og:image" content="https://looca-id.com/favicon.png" />
    <meta property="og:url" content="https://looca-id.com/" />
    <meta property="og:type" content="website" />

    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics mode="production"/>
  </head>
  <body>
    <script define:vars={{ apiUrl: PUBLIC_API_URL }}>
      // Record visitor analytics once per browser session
      (function() {
        try {
          const sessionKey = 'looca_visit_recorded';
          if (!sessionStorage.getItem(sessionKey)) {
            fetch(`${apiUrl}/api/public/visit`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true
            }).then(function(res) {
              if (res.ok) {
                sessionStorage.setItem(sessionKey, Date.now().toString());
              }
            }).catch(function() {});
          }
        } catch (e) {
          fetch(`${apiUrl}/api/public/visit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true
          }).catch(function() {});
        }
      })();
    </script>
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      // Register ScrollTrigger
      gsap.registerPlugin(ScrollTrigger);

      // Optimize ScrollTrigger for mobile performance & prevent address bar resize jitter
      ScrollTrigger.config({
        ignoreMobileResize: true,
        autoRefreshEvents: 'visibilitychange,DOMContentLoaded,load',
      });

      // Detect touch screen devices
      const isTouch = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

      // Only enable Lenis virtual smoothing on non-touch devices (Desktop / Mouse)
      // This preserves 100% native 60fps/120fps touch scroll momentum on mobile phones
      if (!isTouch) {
        const lenis = new Lenis({
          duration: 1.0,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      }

      // Refresh ScrollTrigger once images and DOM are completely loaded
      window.addEventListener('load', () => {
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
