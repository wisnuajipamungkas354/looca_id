# Public Backend URL (used by client browsers to fetch media & API)
PUBLIC_API_URL=https://backend.looca-id.com

# Admin Portal URL (used by navbar login link)
PUBLIC_ADMIN_URL=https://admin.looca-id.com

# Internal API URL (used during 'npm run build' on the Ubuntu server for direct local fetching)
# When building on the same VPS, set this to http://127.0.0.1:8080 to avoid NAT loopback timeouts!
INTERNAL_API_URL=http://127.0.0.1:8080
